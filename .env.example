# Firebase Project Web App Credentials
# Replace the placeholder values with your actual Firebase project settings
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_web_app_id

# Public Demo Student Account (Optional: enables 1-click evaluation for portfolio reviewers)
# Note: This is an unprivileged demo account with pre-seeded campus activity, not an admin secret.
VITE_DEMO_USER_EMAIL=demo.student@campusconnect.edu
VITE_DEMO_USER_PASSWORD=
