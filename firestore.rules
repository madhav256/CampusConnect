rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Validates atomic like/unlike transactions on posts
    function isValidPostLikeUpdate(postId) {
      let likePath = /databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid);
      
      // Liking: like document exists after transaction and likesCount incremented by exactly 1
      let isLike = existsAfter(likePath) &&
                   getAfter(likePath).data.userId == request.auth.uid &&
                   request.resource.data.likesCount == resource.data.likesCount + 1;

      // Unliking: like document no longer exists after transaction and likesCount decremented by exactly 1
      let isUnlike = !existsAfter(likePath) &&
                     request.resource.data.likesCount == resource.data.likesCount - 1 &&
                     request.resource.data.likesCount >= 0;

      // Ensure all other post fields are strictly immutable
      let postFieldsProtected = 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'updatedAt']) &&
        request.resource.data.authorId == resource.data.authorId &&
        request.resource.data.authorName == resource.data.authorName &&
        request.resource.data.authorAvatar == resource.data.authorAvatar &&
        request.resource.data.content == resource.data.content &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.commentsCount == resource.data.commentsCount;

      return (isLike || isUnlike) && postFieldsProtected;
    }

    // Validates comment count updates from commentService
    function isValidPostCommentCountUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentsCount', 'updatedAt']) &&
             request.resource.data.authorId == resource.data.authorId &&
             request.resource.data.authorName == resource.data.authorName &&
             request.resource.data.authorAvatar == resource.data.authorAvatar &&
             request.resource.data.content == resource.data.content &&
             request.resource.data.createdAt == resource.data.createdAt &&
             request.resource.data.likesCount == resource.data.likesCount;
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) &&
        // Protect identity and creation immutability
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.createdAt == resource.data.createdAt &&
        
        // Strictly prevent arbitrary field injection
        request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'email', 'photoURL', 'bio', 
          'department', 'year', 'skills', 'socialLinks', 
          'isDiscoverable', 'notificationPreferences', 
          'createdAt', 'updatedAt'
        ]) &&
        
        // Validate settings types when present
        (!('isDiscoverable' in request.resource.data) || request.resource.data.isDiscoverable is bool) &&
        (!('notificationPreferences' in request.resource.data) || (
          request.resource.data.notificationPreferences is map &&
          request.resource.data.notificationPreferences.keys().hasOnly(['connectionRequests', 'connectionAccepted']) &&
          (!('connectionRequests' in request.resource.data.notificationPreferences) || request.resource.data.notificationPreferences.connectionRequests is bool) &&
          (!('connectionAccepted' in request.resource.data.notificationPreferences) || request.resource.data.notificationPreferences.connectionAccepted is bool)
        ));

      allow delete: if isOwner(userId);
    }

    // 2. Posts collection
    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      
      // Update rules:
      // Post author can update, maintaining author identity;
      // Alternatively, authenticated students can update ONLY via validated comment count batches
      // or validated atomic like/unlike transactions using getAfter()/existsAfter().
      allow update: if isAuthenticated() && (
        (resource.data.authorId == request.auth.uid && request.resource.data.authorId == resource.data.authorId) ||
        isValidPostCommentCountUpdate() ||
        isValidPostLikeUpdate(postId)
      );
      
      // Only the author can delete their own post
      allow delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;

      // 3. Comments subcollection
      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
        allow update: if isAuthenticated() && resource.data.authorId == request.auth.uid && request.resource.data.authorId == resource.data.authorId;
        allow delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;
      }

      // 4. Likes subcollection
      match /likes/{userId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && 
          request.auth.uid == userId && 
          request.resource.data.userId == request.auth.uid;
        allow delete: if isAuthenticated() && request.auth.uid == userId;
        allow update: if false;
      }
    }

    // 5. Connections collection
    match /connections/{connectionId} {
      // Helper: Validates canonical sorted ID: min(uid1, uid2) + "_" + max(uid1, uid2)
      function isValidConnectionId(connId, sId, rId) {
        return connId == (sId < rId ? sId + '_' + rId : rId + '_' + sId);
      }

      // Helper: Validates users array strictly matches sorted participant pair
      function isValidUsersArray(users, sId, rId) {
        return users.size() == 2 &&
               users.hasAll([sId, rId]) &&
               users[0] == (sId < rId ? sId : rId) &&
               users[1] == (sId < rId ? rId : sId);
      }

      // Single-document get: allow if caller is participant, or if doc does not exist yet (needed for getDoc and atomic transaction pre-checks)
      allow get: if isAuthenticated() && (resource == null || request.auth.uid in resource.data.users);

      // List queries: participant-only for array-contains queries
      allow list: if isAuthenticated() && request.auth.uid in resource.data.users;

      // Create pending request with strict invariants
      allow create: if isAuthenticated() &&
        // Caller must be sender
        request.resource.data.senderId == request.auth.uid &&
        // Sender cannot connect with themselves
        request.resource.data.receiverId != request.auth.uid &&
        // Enforce exact canonical connectionId
        isValidConnectionId(connectionId, request.resource.data.senderId, request.resource.data.receiverId) &&
        // Enforce exact sorted users array
        isValidUsersArray(request.resource.data.users, request.resource.data.senderId, request.resource.data.receiverId) &&
        // State must be initialized to pending
        request.resource.data.status == 'pending' &&
        // Timestamps must be valid server timestamps
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        // No extraneous or arbitrary fields
        request.resource.data.keys().hasOnly(['users', 'senderId', 'receiverId', 'status', 'createdAt', 'updatedAt']) &&
        request.resource.data.keys().hasAll(['users', 'senderId', 'receiverId', 'status', 'createdAt', 'updatedAt']);

      // Update: Only pending -> accepted transition allowed by receiverId
      allow update: if isAuthenticated() &&
        // Only receiver can accept
        resource.data.receiverId == request.auth.uid &&
        // Must transition strictly from pending to accepted
        resource.data.status == 'pending' &&
        request.resource.data.status == 'accepted' &&
        // Core participant identity and creation time are completely immutable
        request.resource.data.senderId == resource.data.senderId &&
        request.resource.data.receiverId == resource.data.receiverId &&
        request.resource.data.users == resource.data.users &&
        request.resource.data.createdAt == resource.data.createdAt &&
        // Only status and updatedAt may change
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
        // UpdatedAt must be server timestamp
        request.resource.data.updatedAt == request.time;

      // Delete: Granular delete permissions
      allow delete: if isAuthenticated() && (
        // Sender cancels their own pending outgoing request
        (resource.data.status == 'pending' && resource.data.senderId == request.auth.uid) ||
        // Receiver declines their own pending incoming request
        (resource.data.status == 'pending' && resource.data.receiverId == request.auth.uid) ||
        // Either connected participant removes an accepted connection
        (resource.data.status == 'accepted' && request.auth.uid in resource.data.users)
      );
    }

    // 6. User Notifications subcollection
    match /users/{userId}/notifications/{notificationId} {
      
      // Helper: Validates exact schema keys, types, and baseline invariants
      function isValidNotificationSchema(uId) {
        let d = request.resource.data;
        let keys = d.keys();
        return keys.hasOnly(['id', 'recipientId', 'actorId', 'actorName', 'actorAvatar', 'type', 'referenceId', 'isRead', 'createdAt']) &&
               keys.hasAll(['id', 'recipientId', 'actorId', 'actorName', 'actorAvatar', 'type', 'referenceId', 'isRead', 'createdAt']) &&
               d.id == notificationId &&
               d.recipientId == uId &&
               d.actorId == request.auth.uid &&
               d.actorId != uId &&
               d.isRead == false &&
               d.createdAt == request.time &&
               d.recipientId is string &&
               d.actorId is string &&
               d.actorName is string &&
               (d.actorAvatar == null || d.actorAvatar is string) &&
               d.type is string &&
               d.referenceId is string &&
               d.isRead is bool &&
               d.createdAt is timestamp;
      }

      // Helper: Validates actor name and avatar against the actor's real /users document
      function isValidActorProfile() {
        let actorDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
        return actorDoc != null &&
               request.resource.data.actorName == actorDoc.data.get('displayName', 'CampusConnect Student') &&
               request.resource.data.actorAvatar == actorDoc.data.get('photoURL', null);
      }

      // Helper: Validates connection_request notification matches atomic connection transaction
      function isValidConnectionRequestNotification(uId, notifId) {
        let connId = request.resource.data.referenceId;
        let connPath = /databases/$(database)/documents/connections/$(connId);
        return notifId == 'req_' + connId &&
               request.resource.data.type == 'connection_request' &&
               existsAfter(connPath) &&
               getAfter(connPath).data.status == 'pending' &&
               getAfter(connPath).data.senderId == request.auth.uid &&
               getAfter(connPath).data.receiverId == uId;
      }

      // Helper: Validates connection_accepted notification matches atomic connection transaction
      function isValidConnectionAcceptedNotification(uId, notifId) {
        let connId = request.resource.data.referenceId;
        let connPath = /databases/$(database)/documents/connections/$(connId);
        return notifId == 'acc_' + connId &&
               request.resource.data.type == 'connection_accepted' &&
               existsAfter(connPath) &&
               getAfter(connPath).data.status == 'accepted' &&
               getAfter(connPath).data.receiverId == request.auth.uid &&
               getAfter(connPath).data.senderId == uId;
      }

      // 1. Read: 
      // - List queries: strictly recipient-only (protects privacy)
      allow list: if isAuthenticated() && request.auth.uid == userId;

      // - Single document get: allow recipient, or actor of the specific request notification,
      //   or pre-check reads when the document does not exist
      allow get: if isAuthenticated() && (
        request.auth.uid == userId ||
        (resource != null && resource.data.actorId == request.auth.uid) ||
        (resource == null && notificationId.matches('^req_.*') && notificationId.matches('.*' + request.auth.uid + '.*'))
      );

      // 2. Create: Strictly bound to an atomic connection transaction with verified profile
      allow create: if isAuthenticated() &&
        isValidNotificationSchema(userId) &&
        isValidActorProfile() &&
        (
          isValidConnectionRequestNotification(userId, notificationId) ||
          isValidConnectionAcceptedNotification(userId, notificationId)
        );

      // 3. Update: Only recipient may update, and only the 'isRead' field
      allow update: if isAuthenticated() &&
        request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']) &&
        request.resource.data.isRead is bool;

      // 4. Delete:
      // - Recipient can delete any notification in their inbox
      // - Sender/actor may ONLY delete an outgoing connection_request notification
      //   if the connection document is deleted in the same transaction
      allow delete: if isAuthenticated() && (
        request.auth.uid == userId ||
        (
          resource.data.actorId == request.auth.uid &&
          resource.data.type == 'connection_request' &&
          !existsAfter(/databases/$(database)/documents/connections/$(resource.data.referenceId))
        )
      );
    }
  }
}
