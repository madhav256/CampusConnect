rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserCampusId() {
      return !isAuthenticated() ? null :
        ('campusId' in request.auth.token ? request.auth.token.campusId :
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) ?
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('campusId', null) :
            null
          )
        );
    }

    function isValidSocialLinks(socialLinks) {
      return socialLinks is map &&
             socialLinks.keys().hasOnly(['github', 'linkedin', 'portfolio', 'website']) &&
             socialLinks.keys().hasAll(['github', 'linkedin', 'portfolio', 'website']) &&
             socialLinks.github is string &&
             socialLinks.linkedin is string &&
             socialLinks.portfolio is string &&
             socialLinks.website is string;
    }

    function isValidNotificationPreferencesForCreate(preferences) {
      return preferences is map &&
             preferences.keys().hasAll(['connectionRequests', 'connectionAccepted']) &&
             preferences.keys().hasOnly(['connectionRequests', 'connectionAccepted', 'eventRsvps', 'eventCancellations', 'eventWaitlistOffers']) &&
             preferences.connectionRequests is bool &&
             preferences.connectionAccepted is bool &&
             (!('eventRsvps' in preferences) || preferences.eventRsvps is bool) &&
             (!('eventCancellations' in preferences) || preferences.eventCancellations is bool) &&
             (!('eventWaitlistOffers' in preferences) || preferences.eventWaitlistOffers is bool);
    }

    function isValidNotificationPreferencesForUpdate(preferences) {
      return preferences is map &&
             preferences.keys().hasOnly(['connectionRequests', 'connectionAccepted', 'eventRsvps', 'eventCancellations', 'eventWaitlistOffers']) &&
             (!('connectionRequests' in preferences) || preferences.connectionRequests is bool) &&
             (!('connectionAccepted' in preferences) || preferences.connectionAccepted is bool) &&
             (!('eventRsvps' in preferences) || preferences.eventRsvps is bool) &&
             (!('eventCancellations' in preferences) || preferences.eventCancellations is bool) &&
             (!('eventWaitlistOffers' in preferences) || preferences.eventWaitlistOffers is bool);
    }


    function isValidUserCreate(userId) {
      let d = request.resource.data;
      let pubPath = /databases/$(database)/documents/publicProfiles/$(userId);
      let dirPath = /databases/$(database)/documents/directoryIndex/$(userId);
      return d.keys().hasOnly([
               'uid', 'email', 'isDiscoverable',
               'notificationPreferences', 'createdAt', 'updatedAt',
               'campusId'
             ]) &&
             d.keys().hasAll([
               'uid', 'email', 'isDiscoverable',
               'notificationPreferences', 'createdAt', 'updatedAt'
             ]) &&
             d.uid == userId &&
             d.uid == request.auth.uid &&
             d.email == request.auth.token.email &&
             d.email is string &&
             d.isDiscoverable is bool &&
             isValidNotificationPreferencesForCreate(d.notificationPreferences) &&
             d.createdAt == request.time &&
             d.updatedAt == request.time &&
             (!('campusId' in d) || (
               d.campusId is string &&
               exists(/databases/$(database)/documents/campuses/$(d.campusId))
             )) &&
             existsAfter(pubPath) &&
             (d.isDiscoverable == true ? existsAfter(dirPath) : !existsAfter(dirPath));
    }

    function isValidPublicProfileSchema(userId) {
      let d = request.resource.data;
      return d.keys().hasOnly([
               'uid', 'displayName', 'photoURL', 'bio',
               'department', 'year', 'skills', 'socialLinks',
               'campusId'
             ]) &&
             d.keys().hasAll([
               'uid', 'displayName', 'photoURL', 'bio',
               'department', 'year', 'skills', 'socialLinks'
             ]) &&
             d.uid == userId &&
             d.uid == request.auth.uid &&
             d.displayName is string &&
             (d.photoURL == null || d.photoURL is string) &&
             d.bio is string &&
             d.department is string &&
             d.year is string &&
             d.skills is list &&
             isValidSocialLinks(d.socialLinks) &&
             (!('campusId' in d) || (
               d.campusId is string &&
               exists(/databases/$(database)/documents/campuses/$(d.campusId))
             ));
    }

    function isMatchingDirectoryProjection(dirPath, data) {
      let dirDoc = getAfter(dirPath);
      return dirDoc != null &&
             dirDoc.data.uid == data.uid &&
             dirDoc.data.displayName == data.displayName &&
             dirDoc.data.photoURL == data.photoURL &&
             dirDoc.data.department == data.department &&
             dirDoc.data.year == data.year &&
             dirDoc.data.skills == data.skills &&
             (!('campusId' in data) || dirDoc.data.get('campusId', null) == data.campusId);
    }

    function isValidPublicProfileProjection(userId) {
      let userPath = /databases/$(database)/documents/users/$(userId);
      let dirPath = /databases/$(database)/documents/directoryIndex/$(userId);
      let userDoc = getAfter(userPath);
      return userDoc != null && (
        userDoc.data.isDiscoverable == true ? (
          existsAfter(dirPath) &&
          isMatchingDirectoryProjection(dirPath, request.resource.data)
        ) : (
          !existsAfter(dirPath)
        )
      );
    }

    function isValidDirectoryIndexSchema(userId) {
      let d = request.resource.data;
      return d.keys().hasOnly([
               'uid', 'displayName', 'photoURL', 'department',
               'year', 'skills', 'updatedAt', 'campusId'
             ]) &&
             d.keys().hasAll([
               'uid', 'displayName', 'photoURL', 'department',
               'year', 'skills', 'updatedAt'
             ]) &&
             d.uid == userId &&
             d.uid == request.auth.uid &&
             d.displayName is string &&
             (d.photoURL == null || d.photoURL is string) &&
             d.department is string &&
             d.year is string &&
             d.skills is list &&
             d.updatedAt == request.time &&
             (!('campusId' in d) || (
               d.campusId is string &&
               exists(/databases/$(database)/documents/campuses/$(d.campusId))
             ));
    }

    function isValidDirectoryIndexSync(userId) {
      let userPath = /databases/$(database)/documents/users/$(userId);
      let pubPath = /databases/$(database)/documents/publicProfiles/$(userId);
      let userDoc = getAfter(userPath);
      let pubDoc = getAfter(pubPath);
      return userDoc != null &&
             userDoc.data.isDiscoverable == true &&
             pubDoc != null &&
             request.resource.data.uid == pubDoc.data.uid &&
             request.resource.data.displayName == pubDoc.data.displayName &&
             request.resource.data.photoURL == pubDoc.data.photoURL &&
             request.resource.data.department == pubDoc.data.department &&
             request.resource.data.year == pubDoc.data.year &&
             request.resource.data.skills == pubDoc.data.skills &&
             (!('campusId' in pubDoc.data) || request.resource.data.get('campusId', null) == pubDoc.data.campusId);
    }

    function isValidCommunityPost(d) {
      let communityPath = /databases/$(database)/documents/communities/$(d.communityId);
      let membershipPath = /databases/$(database)/documents/communityMembers/$(d.communityId + '_' + d.authorId);
      return d.communityId is string &&
             'campusId' in d &&
             d.campusId is string &&
             exists(communityPath) &&
             get(communityPath).data.campusId == d.campusId &&
             exists(membershipPath) &&
             get(membershipPath).data.status == 'active';
    }

    function isCommunityModeratorOrAdmin(communityId) {
      let memberPath = /databases/$(database)/documents/communityMembers/$(communityId + '_' + request.auth.uid);
      let memberDoc = exists(memberPath) ? get(memberPath) : null;
      return communityId is string &&
             communityId.size() > 0 &&
             memberDoc != null &&
             memberDoc.data.status == 'active' &&
             memberDoc.data.campusId == getUserCampusId() &&
             (memberDoc.data.role == 'admin' || memberDoc.data.role == 'moderator');
    }

    function isCommunityAdmin(communityId) {
      let memberPath = /databases/$(database)/documents/communityMembers/$(communityId + '_' + request.auth.uid);
      let memberDoc = exists(memberPath) ? get(memberPath) : null;
      return communityId is string &&
             communityId.size() > 0 &&
             memberDoc != null &&
             memberDoc.data.status == 'active' &&
             memberDoc.data.campusId == getUserCampusId() &&
             memberDoc.data.role == 'admin';
    }

    function hasValidStoredChronology(r) {
      return r.startAt is timestamp &&
             r.endAt is timestamp &&
             r.endAt >= r.startAt;
    }

    function isCommunityActiveMember(communityId) {
      return communityId is string &&
             communityId.size() > 0 &&
             exists(/databases/$(database)/documents/communityMembers/$(communityId + '_' + request.auth.uid)) &&
             get(/databases/$(database)/documents/communityMembers/$(communityId + '_' + request.auth.uid)).data.status == 'active' &&
             get(/databases/$(database)/documents/communityMembers/$(communityId + '_' + request.auth.uid)).data.campusId == getUserCampusId();
    }

    function isValidPostCreate() {
      let d = request.resource.data;
      return d.keys().hasOnly([
               'authorId', 'authorName', 'authorAvatar', 'content',
               'likesCount', 'commentsCount', 'createdAt', 'updatedAt',
               'campusId', 'communityId'
             ]) &&
             d.keys().hasAll([
               'authorId', 'authorName', 'authorAvatar', 'content',
               'likesCount', 'commentsCount', 'createdAt', 'updatedAt'
             ]) &&
             d.authorId == request.auth.uid &&
             d.authorName is string &&
             (d.authorAvatar == null || d.authorAvatar is string) &&
             d.content is string &&
             d.content.size() > 0 &&
             d.content.size() <= 2000 &&
             d.likesCount == 0 &&
             d.commentsCount == 0 &&
             d.createdAt == request.time &&
             d.updatedAt == request.time &&
             (!('campusId' in d) || (
               d.campusId is string &&
               getUserCampusId() != null &&
               d.campusId == getUserCampusId()
             )) &&
             (!('communityId' in d) || (
               d.communityId != null &&
               isValidCommunityPost(d)
             ));
    }


    // Validates atomic like/unlike transactions on posts.
    function isValidPostLikeUpdate(postId) {
      let likePath = /databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid);

      let isLike = existsAfter(likePath) &&
                   getAfter(likePath).data.userId == request.auth.uid &&
                   request.resource.data.likesCount == resource.data.likesCount + 1;

      let isUnlike = exists(likePath) &&
                     !existsAfter(likePath) &&
                     request.resource.data.likesCount == resource.data.likesCount - 1 &&
                     request.resource.data.likesCount >= 0;

      let postFieldsProtected =
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'updatedAt']) &&
        request.resource.data.authorId == resource.data.authorId &&
        request.resource.data.authorName == resource.data.authorName &&
        request.resource.data.authorAvatar == resource.data.authorAvatar &&
        request.resource.data.content == resource.data.content &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.commentsCount == resource.data.commentsCount &&
        request.resource.data.updatedAt == request.time;

      return (isLike || isUnlike) && postFieldsProtected;
    }

    // Validates the exact parent mutation used by comment create/delete batches.
    // A parent-only exact +/-1 write remains a documented limitation because this
    // match does not know which arbitrary comment path changed in the same batch.
    function isValidPostCommentCountUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentsCount', 'updatedAt']) &&
             request.resource.data.authorId == resource.data.authorId &&
             request.resource.data.authorName == resource.data.authorName &&
             request.resource.data.authorAvatar == resource.data.authorAvatar &&
             request.resource.data.content == resource.data.content &&
             request.resource.data.createdAt == resource.data.createdAt &&
             request.resource.data.likesCount == resource.data.likesCount &&
             request.resource.data.updatedAt == request.time &&
             request.resource.data.commentsCount >= 0 &&
             (
               request.resource.data.commentsCount == resource.data.commentsCount + 1 ||
               request.resource.data.commentsCount == resource.data.commentsCount - 1
             );
    }

    function isValidCommentSchema() {
      let d = request.resource.data;
      let pubPath = /databases/$(database)/documents/publicProfiles/$(request.auth.uid);
      let pubDoc = exists(pubPath) ? get(pubPath) : null;
      return pubDoc != null &&
             d.keys().hasOnly(['authorId', 'authorName', 'authorAvatar', 'content', 'createdAt', 'updatedAt']) &&
             d.keys().hasAll(['authorId', 'authorName', 'authorAvatar', 'content', 'createdAt', 'updatedAt']) &&
             d.authorId == request.auth.uid &&
             d.authorName == pubDoc.data.get('displayName', 'CampusConnect Student') &&
             d.authorAvatar == pubDoc.data.get('photoURL', null) &&
             d.authorName is string &&
             (d.authorAvatar == null || d.authorAvatar is string) &&
             d.content is string &&
             d.content.size() > 0 &&
             d.createdAt == request.time &&
             d.updatedAt == request.time;
    }

    function isValidCommentCreate(postId) {
      let postPath = /databases/$(database)/documents/posts/$(postId);
      return exists(postPath) &&
             getAfter(postPath).data.commentsCount == get(postPath).data.commentsCount + 1 &&
             getAfter(postPath).data.commentsCount >= 0 &&
             getAfter(postPath).data.updatedAt == request.time;
    }

    function isValidCommentDelete(postId) {
      let postPath = /databases/$(database)/documents/posts/$(postId);
      return resource != null &&
             exists(postPath) &&
             getAfter(postPath).data.commentsCount == get(postPath).data.commentsCount - 1 &&
             getAfter(postPath).data.commentsCount >= 0 &&
             getAfter(postPath).data.updatedAt == request.time;
    }

    function isValidLikeCreate(userId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['userId', 'createdAt']) &&
             d.keys().hasAll(['userId', 'createdAt']) &&
             d.userId == userId &&
             d.userId == request.auth.uid &&
             d.createdAt == request.time;
    }

    // 0. Campuses collection (Authoritative institutional metadata - Read-only for authenticated members)
    match /campuses/{campusId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // 1. Users collection (Private account / settings - Strict Boundary State)
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserCreate(userId);
      allow update: if isOwner(userId) &&
        resource.data.uid == userId &&
        request.resource.data.uid == userId &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'isDiscoverable', 'notificationPreferences', 'updatedAt'
        ]) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['notificationPreferences']) ||
         isValidNotificationPreferencesForUpdate(request.resource.data.notificationPreferences)) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isDiscoverable']) ||
         request.resource.data.isDiscoverable is bool) &&
        (request.resource.data.isDiscoverable == true ?
          existsAfter(/databases/$(database)/documents/directoryIndex/$(userId)) :
          !existsAfter(/databases/$(database)/documents/directoryIndex/$(userId)));

      allow delete: if false;

      // 2. User notifications subcollection
      match /notifications/{notificationId} {
        function isValidNotificationBaseFields(uId, notifId) {
          let d = request.resource.data;
          return d.id == notifId &&
                 d.recipientId == uId &&
                 d.actorId is string &&
                 d.actorId != uId &&
                 d.actorName is string &&
                 (d.actorAvatar == null || d.actorAvatar is string) &&
                 d.type is string &&
                 d.referenceId is string &&
                 d.isRead == false &&
                 d.createdAt == request.time &&
                 (!('referenceTitle' in d) || (d.referenceTitle is string && d.referenceTitle.size() > 0 && d.referenceTitle.size() <= 100));
        }

        function isValidActorProfile() {
          let pubPath = /databases/$(database)/documents/publicProfiles/$(request.auth.uid);
          let pubDoc = exists(pubPath) ? get(pubPath) : null;
          return pubDoc != null &&
                 request.resource.data.actorName == pubDoc.data.get('displayName', 'CampusConnect Student') &&
                 request.resource.data.actorAvatar == pubDoc.data.get('photoURL', null);
        }

        function isValidConnectionRequestNotification(uId, notifId) {
          let connId = request.resource.data.referenceId;
          let connPath = /databases/$(database)/documents/connections/$(connId);
          return notifId == 'req_' + connId &&
                 request.resource.data.type == 'connection_request' &&
                 existsAfter(connPath) &&
                 getAfter(connPath).data.status == 'pending' &&
                 getAfter(connPath).data.senderId == request.auth.uid &&
                 getAfter(connPath).data.receiverId == uId;
        }

        function isValidConnectionAcceptedNotification(uId, notifId) {
          let connId = request.resource.data.referenceId;
          let connPath = /databases/$(database)/documents/connections/$(connId);
          return notifId == 'acc_' + connId &&
                 request.resource.data.type == 'connection_accepted' &&
                 existsAfter(connPath) &&
                 getAfter(connPath).data.status == 'accepted' &&
                 getAfter(connPath).data.receiverId == request.auth.uid &&
                 getAfter(connPath).data.senderId == uId;
        }

        function isValidConnectionNotification(uId, notifId) {
          let d = request.resource.data;
          let keys = d.keys();
          return keys.hasOnly(['id', 'recipientId', 'actorId', 'actorName', 'actorAvatar', 'type', 'referenceId', 'isRead', 'createdAt']) &&
                 keys.hasAll(['id', 'recipientId', 'actorId', 'actorName', 'actorAvatar', 'type', 'referenceId', 'isRead', 'createdAt']) &&
                 !('cycleId' in d) &&
                 !('referenceTitle' in d) &&
                 d.actorId == request.auth.uid &&
                 isValidActorProfile() &&
                 (
                   isValidConnectionRequestNotification(uId, notifId) ||
                   isValidConnectionAcceptedNotification(uId, notifId)
                 );
        }

        function isValidEventRsvpNotification(uId, notifId) {
          let d = request.resource.data;
          let keys = d.keys();
          let eventPath = /databases/$(database)/documents/events/$(d.referenceId);
          let rsvpPath = /databases/$(database)/documents/eventRsvps/$(d.referenceId + '_' + request.auth.uid);
          let eventDoc = exists(eventPath) ? get(eventPath) : null;
          let rsvpDoc = existsAfter(rsvpPath) ? getAfter(rsvpPath) : null;

          return keys.hasOnly(['id', 'recipientId', 'actorId', 'actorName', 'actorAvatar', 'type', 'referenceId', 'isRead', 'createdAt', 'referenceTitle']) &&
                 keys.hasAll(['id', 'recipientId', 'actorId', 'actorName', 'actorAvatar', 'type', 'referenceId', 'isRead', 'createdAt']) &&
                 !('cycleId' in d) &&
                 d.type == 'event_rsvp' &&
                 notifId == 'rsvp_' + d.referenceId + '_' + request.auth.uid &&
                 d.actorId == request.auth.uid &&
                 isValidActorProfile() &&
                 eventDoc != null &&
                 eventDoc.data.campusId == getUserCampusId() &&
                 eventDoc.data.status == 'published' &&
                 eventDoc.data.createdBy == uId &&
                 (!('referenceTitle' in d) || d.referenceTitle == eventDoc.data.title) &&
                 rsvpDoc != null &&
                 rsvpDoc.data.userId == request.auth.uid &&
                 rsvpDoc.data.eventId == d.referenceId &&
                 rsvpDoc.data.campusId == getUserCampusId();
        }

        function isValidEventCancelledNotification(uId, notifId) {
          let d = request.resource.data;
          let keys = d.keys();
          let eventPath = /databases/$(database)/documents/events/$(d.referenceId);
          let ledgerPath = /databases/$(database)/documents/eventNotificationDeliveries/$(d.referenceId);
          let rsvpPath = /databases/$(database)/documents/eventRsvps/$(d.referenceId + '_' + uId);
          let eventDoc = exists(eventPath) ? get(eventPath) : null;
          let ledgerDoc = exists(ledgerPath) ? get(ledgerPath) : null;

          return keys.hasOnly(['id', 'recipientId', 'actorId', 'actorName', 'actorAvatar', 'type', 'referenceId', 'cycleId', 'isRead', 'createdAt', 'referenceTitle']) &&
                 keys.hasAll(['id', 'recipientId', 'actorId', 'actorName', 'actorAvatar', 'type', 'referenceId', 'cycleId', 'isRead', 'createdAt']) &&
                 d.type == 'event_cancelled' &&
                 d.cycleId is string &&
                 d.cycleId.size() >= 10 &&
                 d.cycleId.size() <= 64 &&
                 notifId == 'cancel_' + d.referenceId + '_' + d.cycleId &&
                 eventDoc != null &&
                 eventDoc.data.status == 'cancelled' &&
                 eventDoc.data.campusId == getUserCampusId() &&
                 (!('referenceTitle' in d) || d.referenceTitle == eventDoc.data.title) &&
                 ledgerDoc != null &&
                 ledgerDoc.data.eventId == d.referenceId &&
                 ledgerDoc.data.cycleId == d.cycleId &&
                 ledgerDoc.data.communityId == eventDoc.data.communityId &&
                 ledgerDoc.data.campusId == eventDoc.data.campusId &&
                 ledgerDoc.data.status in ['pending', 'in_progress'] &&
                 d.actorId == ledgerDoc.data.actorId &&
                 d.actorName == ledgerDoc.data.actorName &&
                 d.actorAvatar == ledgerDoc.data.actorAvatar &&
                 (
                   request.auth.uid == eventDoc.data.createdBy ||
                   isCommunityModeratorOrAdmin(ledgerDoc.data.communityId)
                 ) &&
                 exists(rsvpPath);
        }

        // Allows an acceptance transaction to refresh an existing deterministic
        // notification without granting the actor general notification updates.
        function isValidConnectionAcceptedNotificationUpdate(uId, notifId) {
          let connId = request.resource.data.referenceId;
          let connPath = /databases/$(database)/documents/connections/$(connId);
          return resource != null &&
                 resource.data.id == notifId &&
                 resource.data.recipientId == uId &&
                 resource.data.actorId == request.auth.uid &&
                 resource.data.type == 'connection_accepted' &&
                 resource.data.referenceId == connId &&
                 existsAfter(connPath) &&
                 getAfter(connPath).data.status == 'accepted' &&
                 getAfter(connPath).data.receiverId == request.auth.uid &&
                 getAfter(connPath).data.senderId == uId;
        }

        function isValidRequestCancellationDelete(uId) {
          return resource != null &&
                 resource.data.id == notificationId &&
                 resource.data.recipientId == uId &&
                 resource.data.actorId == request.auth.uid &&
                 resource.data.type == 'connection_request' &&
                 notificationId == 'req_' + resource.data.referenceId &&
                 exists(/databases/$(database)/documents/connections/$(resource.data.referenceId)) &&
                 get(/databases/$(database)/documents/connections/$(resource.data.referenceId)).data.status == 'pending' &&
                 get(/databases/$(database)/documents/connections/$(resource.data.referenceId)).data.senderId == request.auth.uid &&
                 get(/databases/$(database)/documents/connections/$(resource.data.referenceId)).data.receiverId == uId &&
                 !existsAfter(/databases/$(database)/documents/connections/$(resource.data.referenceId));
        }

        allow list: if isAuthenticated() && request.auth.uid == userId;
        allow get: if isAuthenticated() && request.auth.uid == userId;

        allow create: if isAuthenticated() &&
          isValidNotificationBaseFields(userId, notificationId) &&
          (
            (request.resource.data.type in ['connection_request', 'connection_accepted'] && isValidConnectionNotification(userId, notificationId)) ||
            (request.resource.data.type == 'event_rsvp' && isValidEventRsvpNotification(userId, notificationId)) ||
            (request.resource.data.type == 'event_cancelled' && isValidEventCancelledNotification(userId, notificationId))
          );

        allow update: if isAuthenticated() && (
          (
            request.auth.uid == userId &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']) &&
            request.resource.data.isRead is bool
          ) ||
          (
            isValidNotificationBaseFields(userId, notificationId) &&
            isValidActorProfile() &&
            isValidConnectionAcceptedNotificationUpdate(userId, notificationId)
          )
        );

        allow delete: if isAuthenticated() && (
          request.auth.uid == userId ||
          isValidRequestCancellationDelete(userId) ||
          (resource == null && notificationId.matches('^req_.*'))
        );
      }

    }

    // 1b. Public profiles collection (Sole authority for public profile fields)
    match /publicProfiles/{userId} {
      allow read: if isAuthenticated() && (
        !('campusId' in resource.data) ||
        resource.data.campusId == getUserCampusId()
      );
      allow create: if isOwner(userId) &&
        isValidPublicProfileSchema(userId) &&
        isValidPublicProfileProjection(userId);
      allow update: if isOwner(userId) &&
        isValidPublicProfileSchema(userId) &&
        isValidPublicProfileProjection(userId);
      allow delete: if false;
    }

    // 1c. Directory index collection (Projection of publicProfiles)
    match /directoryIndex/{userId} {
      allow read: if isAuthenticated() && (
        !('campusId' in resource.data) ||
        resource.data.campusId == getUserCampusId()
      );
      allow create: if isOwner(userId) &&
        isValidDirectoryIndexSchema(userId) &&
        isValidDirectoryIndexSync(userId);
      allow update: if isOwner(userId) &&
        isValidDirectoryIndexSchema(userId) &&
        isValidDirectoryIndexSync(userId);
      allow delete: if isOwner(userId) &&
        getAfter(/databases/$(database)/documents/users/$(userId)).data.isDiscoverable == false;
    }

    // 3. Posts collection
    match /posts/{postId} {
      allow read: if isAuthenticated() && (
        !('campusId' in resource.data) ||
        resource.data.campusId == getUserCampusId()
      );
      allow create: if isAuthenticated() && isValidPostCreate();

      // Posts are not editable. Only the validated counter/like paths remain.
      allow update: if isAuthenticated() && (
        isValidPostCommentCountUpdate() ||
        isValidPostLikeUpdate(postId)
      );

      allow delete: if isAuthenticated() && (
        resource.data.authorId == request.auth.uid ||
        (
          'communityId' in resource.data &&
          resource.data.communityId != null &&
          resource.data.campusId == getUserCampusId() &&
          isCommunityModeratorOrAdmin(resource.data.communityId)
        )
      );

      match /comments/{commentId} {
        allow read: if isAuthenticated() && (
          !exists(/databases/$(database)/documents/posts/$(postId)) ||
          !('campusId' in get(/databases/$(database)/documents/posts/$(postId)).data) ||
          get(/databases/$(database)/documents/posts/$(postId)).data.campusId == getUserCampusId()
        );
        allow create: if isAuthenticated() &&
          isValidCommentSchema() &&
          isValidCommentCreate(postId) &&
          (
            !('campusId' in get(/databases/$(database)/documents/posts/$(postId)).data) ||
            get(/databases/$(database)/documents/posts/$(postId)).data.campusId == getUserCampusId()
          );
        allow update: if false;
        allow delete: if isAuthenticated() &&
          resource.data.authorId == request.auth.uid &&
          isValidCommentDelete(postId);
      }

      match /likes/{userId} {
        allow read: if isAuthenticated() && (
          !exists(/databases/$(database)/documents/posts/$(postId)) ||
          !('campusId' in get(/databases/$(database)/documents/posts/$(postId)).data) ||
          get(/databases/$(database)/documents/posts/$(postId)).data.campusId == getUserCampusId()
        );
        allow create: if isAuthenticated() &&
          isValidLikeCreate(userId) &&
          (
            !exists(/databases/$(database)/documents/posts/$(postId)) ||
            !('campusId' in get(/databases/$(database)/documents/posts/$(postId)).data) ||
            get(/databases/$(database)/documents/posts/$(postId)).data.campusId == getUserCampusId()
          );
        allow delete: if isAuthenticated() && request.auth.uid == userId;
        allow update: if false;
      }
    }

    // 4. Connections collection
    match /connections/{connectionId} {
      function isValidConnectionId(connId, sId, rId) {
        return connId == (sId < rId ? sId + '_' + rId : rId + '_' + sId);
      }

      function isValidUsersArray(users, sId, rId) {
        return users.size() == 2 &&
               users.hasAll([sId, rId]) &&
               users[0] == (sId < rId ? sId : rId) &&
               users[1] == (sId < rId ? rId : sId);
      }

      allow get: if isAuthenticated() && (
        resource == null ||
        (
          request.auth.uid in resource.data.users &&
          (!('campusId' in resource.data) || resource.data.campusId == getUserCampusId())
        )
      );
      allow list: if isAuthenticated() &&
        request.auth.uid in resource.data.users &&
        (!('campusId' in resource.data) || resource.data.campusId == getUserCampusId());

      allow create: if isAuthenticated() &&
        request.resource.data.senderId == request.auth.uid &&
        request.resource.data.receiverId != request.auth.uid &&
        isValidConnectionId(connectionId, request.resource.data.senderId, request.resource.data.receiverId) &&
        isValidUsersArray(request.resource.data.users, request.resource.data.senderId, request.resource.data.receiverId) &&
        request.resource.data.status == 'pending' &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.keys().hasOnly(['users', 'senderId', 'receiverId', 'status', 'createdAt', 'updatedAt', 'campusId']) &&
        request.resource.data.keys().hasAll(['users', 'senderId', 'receiverId', 'status', 'createdAt', 'updatedAt']) &&
        (
          !('campusId' in request.resource.data) || (
            request.resource.data.campusId is string &&
            request.resource.data.campusId == getUserCampusId()
          )
        ) &&
        (
          getUserCampusId() == null ||
          !exists(/databases/$(database)/documents/users/$(request.resource.data.receiverId)) ||
          !('campusId' in get(/databases/$(database)/documents/users/$(request.resource.data.receiverId)).data) ||
          get(/databases/$(database)/documents/users/$(request.resource.data.receiverId)).data.campusId == getUserCampusId()
        );

      allow update: if isAuthenticated() &&
        resource.data.receiverId == request.auth.uid &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'accepted' &&
        request.resource.data.senderId == resource.data.senderId &&
        request.resource.data.receiverId == resource.data.receiverId &&
        request.resource.data.users == resource.data.users &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
        request.resource.data.updatedAt == request.time;

      allow delete: if isAuthenticated() && (
        (resource.data.status == 'pending' && resource.data.senderId == request.auth.uid) ||
        (resource.data.status == 'pending' && resource.data.receiverId == request.auth.uid) ||
        (resource.data.status == 'accepted' && request.auth.uid in resource.data.users)
      );
    }

    // 5. Conversations collection
    match /conversations/{conversationId} {
      function isValidConversationParticipants(participants) {
        return participants is list &&
               participants.size() == 2 &&
               participants[0] is string &&
               participants[1] is string &&
               participants[0] < participants[1];
      }

      function isValidConversationId(convId, p0, p1) {
        return convId == (p0 < p1 ? p0 + '_' + p1 : p1 + '_' + p0);
      }

      function isValidParticipantProfiles(p0, p1, profiles) {
        let pubPath0 = /databases/$(database)/documents/publicProfiles/$(p0);
        let pubPath1 = /databases/$(database)/documents/publicProfiles/$(p1);
        let pubDoc0 = exists(pubPath0) ? get(pubPath0) : null;
        let pubDoc1 = exists(pubPath1) ? get(pubPath1) : null;

        return pubDoc0 != null && pubDoc1 != null &&
               profiles is map &&
               profiles.keys().hasOnly([p0, p1]) &&
               profiles.keys().hasAll([p0, p1]) &&
               profiles[p0] is map &&
               profiles[p0].keys().hasOnly(['displayName', 'photoURL']) &&
               profiles[p0].displayName == pubDoc0.data.get('displayName', 'CampusConnect Student') &&
               profiles[p0].photoURL == pubDoc0.data.get('photoURL', null) &&
               profiles[p1] is map &&
               profiles[p1].keys().hasOnly(['displayName', 'photoURL']) &&
               profiles[p1].displayName == pubDoc1.data.get('displayName', 'CampusConnect Student') &&
               profiles[p1].photoURL == pubDoc1.data.get('photoURL', null);
      }

      function isValidConversationCreate(convId) {
        let d = request.resource.data;
        let p = d.participants;
        let connPath = /databases/$(database)/documents/connections/$(convId);
        let msgPath = /databases/$(database)/documents/conversations/$(convId)/messages/$(d.lastMessage.id);
        let msgDoc = existsAfter(msgPath) ? getAfter(msgPath) : null;

        return d.keys().hasOnly([
                 'id', 'participants', 'participantProfiles',
                 'lastMessage', 'unreadCount', 'createdAt', 'updatedAt'
               ]) &&
               d.keys().hasAll([
                 'id', 'participants', 'participantProfiles',
                 'lastMessage', 'unreadCount', 'createdAt', 'updatedAt'
               ]) &&
               d.id == convId &&
               isValidConversationParticipants(p) &&
               isValidConversationId(convId, p[0], p[1]) &&
               request.auth.uid in p &&
               exists(connPath) &&
               get(connPath).data.status == 'accepted' &&
               isValidParticipantProfiles(p[0], p[1], d.participantProfiles) &&
               d.lastMessage is map &&
               d.lastMessage.keys().hasOnly(['id', 'content', 'senderId', 'createdAt']) &&
               d.lastMessage.keys().hasAll(['id', 'content', 'senderId', 'createdAt']) &&
               d.lastMessage.id is string &&
               d.lastMessage.senderId == request.auth.uid &&
               d.lastMessage.content is string &&
               d.lastMessage.content.size() > 0 &&
               d.lastMessage.content.size() <= 1000 &&
               d.lastMessage.createdAt == request.time &&
               msgDoc != null &&
               msgDoc.data.id == d.lastMessage.id &&
               msgDoc.data.conversationId == convId &&
               msgDoc.data.senderId == request.auth.uid &&
               msgDoc.data.content == d.lastMessage.content &&
               msgDoc.data.createdAt == request.time &&
               d.unreadCount is map &&
               d.unreadCount.keys().hasOnly([p[0], p[1]]) &&
               d.unreadCount.keys().hasAll([p[0], p[1]]) &&
               d.unreadCount[request.auth.uid] == 0 &&
               d.unreadCount[p[0] == request.auth.uid ? p[1] : p[0]] == 1 &&
               d.createdAt == request.time &&
               d.updatedAt == request.time;
      }

      function isValidConversationMessageSendUpdate(convId) {
        let d = request.resource.data;
        let r = resource.data;
        let p = r.participants;
        let p0 = p[0];
        let p1 = p[1];
        let senderId = request.auth.uid;
        let recipientId = (p0 == senderId ? p1 : p0);
        let connPath = /databases/$(database)/documents/connections/$(convId);
        let msgPath = /databases/$(database)/documents/conversations/$(convId)/messages/$(d.lastMessage.id);
        let msgDoc = existsAfter(msgPath) ? getAfter(msgPath) : null;

        return senderId in p &&
               exists(connPath) &&
               get(connPath).data.status == 'accepted' &&
               d.diff(r).affectedKeys().hasOnly(['lastMessage', 'unreadCount', 'updatedAt']) &&
               d.id == r.id &&
               d.participants == r.participants &&
               d.participantProfiles == r.participantProfiles &&
               d.createdAt == r.createdAt &&
               d.updatedAt == request.time &&
               d.lastMessage is map &&
               d.lastMessage.keys().hasOnly(['id', 'content', 'senderId', 'createdAt']) &&
               d.lastMessage.keys().hasAll(['id', 'content', 'senderId', 'createdAt']) &&
               d.lastMessage.id is string &&
               d.lastMessage.senderId == senderId &&
               d.lastMessage.content is string &&
               d.lastMessage.content.size() > 0 &&
               d.lastMessage.content.size() <= 1000 &&
               d.lastMessage.createdAt == request.time &&
               msgDoc != null &&
               msgDoc.data.id == d.lastMessage.id &&
               msgDoc.data.conversationId == convId &&
               msgDoc.data.senderId == senderId &&
               msgDoc.data.content == d.lastMessage.content &&
               msgDoc.data.createdAt == request.time &&
               d.unreadCount is map &&
               d.unreadCount.keys().hasOnly([p0, p1]) &&
               d.unreadCount.keys().hasAll([p0, p1]) &&
               d.unreadCount[senderId] == 0 &&
               d.unreadCount[recipientId] == r.unreadCount[recipientId] + 1;
      }

      function isValidConversationReadResetUpdate() {
        let d = request.resource.data;
        let r = resource.data;
        let p = r.participants;
        let p0 = p[0];
        let p1 = p[1];
        let myId = request.auth.uid;
        let peerId = (p0 == myId ? p1 : p0);

        return myId in p &&
               d.diff(r).affectedKeys().hasOnly(['unreadCount']) &&
               d.id == r.id &&
               d.participants == r.participants &&
               d.participantProfiles == r.participantProfiles &&
               d.lastMessage == r.lastMessage &&
               d.createdAt == r.createdAt &&
               d.updatedAt == r.updatedAt &&
               d.unreadCount is map &&
               d.unreadCount.keys().hasOnly([p0, p1]) &&
               d.unreadCount.keys().hasAll([p0, p1]) &&
               d.unreadCount[myId] == 0 &&
               d.unreadCount[peerId] == r.unreadCount[peerId];
      }

      allow get: if isAuthenticated() && (resource == null || request.auth.uid in resource.data.participants);
      allow list: if isAuthenticated() && request.auth.uid in resource.data.participants;

      allow create: if isAuthenticated() && isValidConversationCreate(conversationId);

      allow update: if isAuthenticated() && (
        isValidConversationMessageSendUpdate(conversationId) ||
        isValidConversationReadResetUpdate()
      );

      allow delete: if false;

      // 6. Messages subcollection
      match /messages/{messageId} {
        function isValidMessageCreate(convId, msgId) {
          let d = request.resource.data;
          let convPath = /databases/$(database)/documents/conversations/$(convId);
          let connPath = /databases/$(database)/documents/connections/$(convId);
          let convDoc = existsAfter(convPath) ? getAfter(convPath) : null;

          return d.keys().hasOnly(['id', 'conversationId', 'senderId', 'content', 'createdAt']) &&
                 d.keys().hasAll(['id', 'conversationId', 'senderId', 'content', 'createdAt']) &&
                 d.id == msgId &&
                 d.conversationId == convId &&
                 d.senderId == request.auth.uid &&
                 d.content is string &&
                 d.content.size() > 0 &&
                 d.content.size() <= 1000 &&
                 d.createdAt == request.time &&
                 convDoc != null &&
                 request.auth.uid in convDoc.data.participants &&
                 convDoc.data.lastMessage is map &&
                 convDoc.data.lastMessage.id == msgId &&
                 convDoc.data.lastMessage.content == d.content &&
                 convDoc.data.lastMessage.senderId == request.auth.uid &&
                 convDoc.data.lastMessage.createdAt == request.time &&
                 exists(connPath) &&
                 get(connPath).data.status == 'accepted';
        }

        allow read: if isAuthenticated() && (
          exists(/databases/$(database)/documents/conversations/$(conversationId)) &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
        );

        allow create: if isAuthenticated() && isValidMessageCreate(conversationId, messageId);
        allow update: if false;
        allow delete: if false;
      }
    }

    // 7. Communities collection (Campus Community Authority - Milestone 19)
    match /communities/{communityId} {
      allow read: if isAuthenticated() && (
        !('campusId' in resource.data) ||
        resource.data.campusId == getUserCampusId()
      );
      allow write: if false;
    }

    // 8. Community Members collection (Community Membership & Security Authority - Milestone 19.2/19.8)
    match /communityMembers/{membershipId} {
      function isCommunityAdmin(communityId) {
        let adminMembershipPath = /databases/$(database)/documents/communityMembers/$(communityId + '_' + request.auth.uid);
        return exists(adminMembershipPath) &&
               get(adminMembershipPath).data.role == 'admin' &&
               get(adminMembershipPath).data.status == 'active' &&
               get(adminMembershipPath).data.campusId == getUserCampusId();
      }

      function isCommunityModerator(communityId) {
        let modMembershipPath = /databases/$(database)/documents/communityMembers/$(communityId + '_' + request.auth.uid);
        return exists(modMembershipPath) &&
               get(modMembershipPath).data.role == 'moderator' &&
               get(modMembershipPath).data.status == 'active' &&
               get(modMembershipPath).data.campusId == getUserCampusId();
      }

      function isValidCommunityMemberCreate(mId) {
        let d = request.resource.data;
        let communityPath = /databases/$(database)/documents/communities/$(d.communityId);
        return d.keys().hasOnly(['id', 'communityId', 'userId', 'campusId', 'role', 'status', 'joinedAt', 'updatedAt']) &&
               d.keys().hasAll(['id', 'communityId', 'userId', 'campusId', 'role', 'status', 'joinedAt', 'updatedAt']) &&
               d.id == mId &&
               d.id == d.communityId + '_' + d.userId &&
               d.userId == request.auth.uid &&
               d.campusId is string &&
               getUserCampusId() != null &&
               d.campusId == getUserCampusId() &&
               d.role == 'member' &&
               d.status in ['active', 'pending'] &&
               d.joinedAt == request.time &&
               d.updatedAt == request.time &&
               exists(communityPath) &&
               get(communityPath).data.campusId == d.campusId;
      }

      function isValidCommunityMemberUpdate(mId) {
        let d = request.resource.data;
        let r = resource.data;
        let isOwner = request.auth.uid == r.userId;
        let isAdmin = isCommunityAdmin(r.communityId);
        let isMod = isCommunityModerator(r.communityId);

        let immutableFieldsPreserved =
          d.id == r.id &&
          d.communityId == r.communityId &&
          d.userId == r.userId &&
          d.campusId == r.campusId &&
          d.joinedAt == r.joinedAt &&
          d.updatedAt == request.time &&
          r.campusId == getUserCampusId();

        let validOwnerUpdate =
          isOwner &&
          immutableFieldsPreserved &&
          d.role == r.role &&
          d.diff(r).affectedKeys().hasOnly(['status', 'updatedAt']) &&
          r.status == 'active' &&
          d.status == 'removed';

        let validAdminUpdate =
          isAdmin &&
          immutableFieldsPreserved &&
          d.diff(r).affectedKeys().hasOnly(['role', 'status', 'updatedAt']) &&
          d.role in ['member', 'moderator', 'admin'] &&
          d.status in ['active', 'removed', 'pending'];

        let validModeratorUpdate =
          isMod &&
          immutableFieldsPreserved &&
          r.role == 'member' &&
          d.role == r.role &&
          d.diff(r).affectedKeys().hasOnly(['status', 'updatedAt']) &&
          d.status in ['active', 'removed', 'pending'];

        return (validOwnerUpdate || validAdminUpdate || validModeratorUpdate);
      }

      allow read: if isAuthenticated() && (
        !('campusId' in resource.data) ||
        resource.data.campusId == getUserCampusId()
      );

      allow create: if isAuthenticated() && isValidCommunityMemberCreate(membershipId);

      allow update: if isAuthenticated() && isValidCommunityMemberUpdate(membershipId);

      allow delete: if isAuthenticated() && (
        (request.auth.uid == resource.data.userId && resource.data.status == 'active') ||
        isCommunityAdmin(resource.data.communityId)
      );
    }

    // 9. Events collection (Milestone 20.3, Milestone 22.1 & Milestone 24)
    match /events/{eventId} {
      function isValidEventCreate(eId) {
        let d = request.resource.data;
        let capPath = /databases/$(database)/documents/eventCapacities/$(eId);
        let isCapped = ('capacity' in d) && d.capacity != null;
        let capDoc = (isCapped && existsAfter(capPath)) ? getAfter(capPath) : null;

        let communityPath = ('communityId' in d && d.communityId is string) ?
          /databases/$(database)/documents/communities/$(d.communityId) : null;
        let hasValidCommunityAuthority =
          communityPath != null &&
          exists(communityPath) &&
          get(communityPath).data.campusId == getUserCampusId() &&
          isCommunityModeratorOrAdmin(d.communityId);

        let isCapCoordAtomic =
          (
            isCapped &&
            d.capacity is int && d.capacity > 0 && d.capacity <= 10000 &&
            !exists(capPath) && existsAfter(capPath) &&
            capDoc != null &&
            capDoc.data.id == eId &&
            capDoc.data.eventId == eId &&
            capDoc.data.campusId == d.campusId &&
            capDoc.data.confirmedCount == 0 &&
            capDoc.data.offeredCount == 0 &&
            capDoc.data.waitlistCount == 0 &&
            capDoc.data.headSequence == 1 &&
            capDoc.data.nextSequence == 1
          ) ||
          (!isCapped && !exists(capPath) && !existsAfter(capPath));

        return d.keys().hasOnly([
                 'id', 'campusId', 'communityId', 'title', 'slug', 'description',
                 'category', 'location', 'startAt', 'endAt', 'imageURL',
                 'createdBy', 'organizerName', 'status', 'visibility',
                 'createdAt', 'updatedAt', 'capacity'
               ]) &&
               d.keys().hasAll([
                 'id', 'campusId', 'communityId', 'title', 'slug', 'description',
                 'category', 'location', 'startAt', 'endAt', 'imageURL',
                 'createdBy', 'organizerName', 'status', 'visibility',
                 'createdAt', 'updatedAt'
               ]) &&
               d.id == eId &&
               d.createdBy == request.auth.uid &&
               d.campusId is string &&
               getUserCampusId() != null &&
               d.campusId == getUserCampusId() &&
               hasValidCommunityAuthority &&
               d.title is string &&
               d.title.size() >= 3 &&
               d.title.size() <= 100 &&
               d.slug is string &&
               d.slug.size() > 0 &&
               d.description is string &&
               d.description.size() > 0 &&
               d.description.size() <= 3000 &&
               d.category in [
                 'academic', 'tech', 'cultural', 'sports',
                 'career', 'workshop', 'social', 'competition'
               ] &&
               d.location is string &&
               d.location.size() > 0 &&
               d.location.size() <= 200 &&
               d.startAt is timestamp &&
               d.endAt is timestamp &&
               d.endAt >= d.startAt &&
               (d.imageURL == null || (d.imageURL is string && d.imageURL.size() > 0)) &&
               d.organizerName is string &&
               d.organizerName.size() > 0 &&
               d.status == 'published' &&
               d.visibility in ['campus_public', 'community_only'] &&
               d.createdAt == request.time &&
               d.updatedAt == request.time &&
               isCapCoordAtomic;
      }

      function isValidPathwayA(eId, d, r, affected) {
        let capPath = /databases/$(database)/documents/eventCapacities/$(eId);
        let capDoc = affected.hasAny(['capacity']) && exists(capPath) ? get(capPath) : null;

        let isCapacityUnchanged = !affected.hasAny(['capacity']);
        let isCapacityValidlyUpdated =
          affected.hasAny(['capacity']) &&
          ('capacity' in r) && ('capacity' in d) &&
          d.capacity is int && d.capacity > 0 && d.capacity <= 10000 &&
          d.capacity != r.capacity &&
          capDoc != null &&
          d.capacity >= (capDoc.data.confirmedCount + capDoc.data.offeredCount);

        let hasValidFieldTypes =
          d.title is string && d.title.size() >= 3 && d.title.size() <= 100 &&
          d.slug is string && d.slug.size() > 0 &&
          d.description is string && d.description.size() > 0 && d.description.size() <= 3000 &&
          d.category in ['academic', 'tech', 'cultural', 'sports', 'career', 'workshop', 'social', 'competition'] &&
          d.location is string && d.location.size() > 0 && d.location.size() <= 200 &&
          (d.imageURL == null || (d.imageURL is string && d.imageURL.size() > 0)) &&
          d.organizerName is string && d.organizerName.size() > 0;

        let hasValidTimeTransition =
          (request.time < r.startAt &&
           (!affected.hasAny(['startAt']) || (d.startAt is timestamp && d.startAt > request.time)) &&
           (!affected.hasAny(['startAt', 'endAt']) || (d.endAt is timestamp && d.endAt >= d.startAt))) ||
          (request.time >= r.startAt &&
           request.time <= r.endAt &&
           d.startAt == r.startAt &&
           d.title == r.title &&
           d.slug == r.slug &&
           d.category == r.category &&
           d.organizerName == r.organizerName &&
           (!affected.hasAny(['endAt']) || (d.endAt is timestamp && d.endAt >= r.endAt && d.endAt > request.time)));

        return affected.hasOnly([
                 'title', 'slug', 'description', 'category', 'location',
                 'startAt', 'endAt', 'imageURL', 'organizerName',
                 'updatedAt', 'capacity'
               ]) &&
               affected.hasAny([
                 'title', 'slug', 'description', 'category', 'location',
                 'startAt', 'endAt', 'imageURL', 'organizerName',
                 'capacity'
               ]) &&
               d.visibility == r.visibility &&
               d.campusId == r.campusId &&
               d.communityId == r.communityId &&
               d.createdBy == r.createdBy &&
               d.createdAt == r.createdAt &&
               d.updatedAt == request.time &&
               hasValidFieldTypes &&
               hasValidTimeTransition &&
               (isCapacityUnchanged || isCapacityValidlyUpdated);
      }

      function hasValidInitialLedger(eId, r) {
        let ledgerPath = /databases/$(database)/documents/eventNotificationDeliveries/$(eId);
        return !exists(ledgerPath) &&
               existsAfter(ledgerPath) &&
               getAfter(ledgerPath).data.id == eId &&
               getAfter(ledgerPath).data.eventId == eId &&
               getAfter(ledgerPath).data.campusId == r.campusId &&
               getAfter(ledgerPath).data.communityId == r.communityId &&
               getAfter(ledgerPath).data.actorId == request.auth.uid &&
               getAfter(ledgerPath).data.status == 'pending' &&
               getAfter(ledgerPath).data.checkpointVersion == 0 &&
               getAfter(ledgerPath).data.processedCount == 0 &&
               (!('lastProcessedRsvpId' in getAfter(ledgerPath).data) || getAfter(ledgerPath).data.lastProcessedRsvpId == null) &&
               getAfter(ledgerPath).data.cycleId is string &&
               getAfter(ledgerPath).data.cycleId.size() >= 10 &&
               getAfter(ledgerPath).data.cycleId.size() <= 64;
      }

      function hasValidRepeatLedger(eId, r) {
        let ledgerPath = /databases/$(database)/documents/eventNotificationDeliveries/$(eId);
        return exists(ledgerPath) &&
               existsAfter(ledgerPath) &&
               get(ledgerPath).data.status in ['completed', 'superseded'] &&
               getAfter(ledgerPath).data.id == eId &&
               getAfter(ledgerPath).data.eventId == eId &&
               getAfter(ledgerPath).data.campusId == r.campusId &&
               getAfter(ledgerPath).data.communityId == r.communityId &&
               getAfter(ledgerPath).data.actorId == request.auth.uid &&
               getAfter(ledgerPath).data.status == 'pending' &&
               getAfter(ledgerPath).data.checkpointVersion == 0 &&
               getAfter(ledgerPath).data.processedCount == 0 &&
               (!('lastProcessedRsvpId' in getAfter(ledgerPath).data) || getAfter(ledgerPath).data.lastProcessedRsvpId == null) &&
               getAfter(ledgerPath).data.cycleId is string &&
               getAfter(ledgerPath).data.cycleId.size() >= 10 &&
               getAfter(ledgerPath).data.cycleId.size() <= 64 &&
               getAfter(ledgerPath).data.cycleId != get(ledgerPath).data.cycleId;
      }

      function isValidPathwayB(eId, d, r, affected) {
        return request.time <= r.endAt &&
               affected.hasOnly(['status', 'updatedAt']) &&
               d.title == r.title &&
               d.slug == r.slug &&
               d.description == r.description &&
               d.category == r.category &&
               d.location == r.location &&
               d.startAt == r.startAt &&
               d.endAt == r.endAt &&
               d.imageURL == r.imageURL &&
               d.organizerName == r.organizerName &&
               (hasValidInitialLedger(eId, r) || hasValidRepeatLedger(eId, r));
      }

      function isValidPathwayC(d, r, affected) {
        return request.time < r.startAt &&
               affected.hasOnly(['status', 'updatedAt']) &&
               d.title == r.title &&
               d.slug == r.slug &&
               d.description == r.description &&
               d.category == r.category &&
               d.location == r.location &&
               d.startAt == r.startAt &&
               d.endAt == r.endAt &&
               d.imageURL == r.imageURL &&
               d.organizerName == r.organizerName;
      }

      function isValidEventUpdate(eId) {
        let d = request.resource.data;
        let r = resource.data;
        let diff = d.diff(r);
        let affected = diff.affectedKeys();

        let isLeader = r.communityId != null && isCommunityModeratorOrAdmin(r.communityId);

        return isLeader &&
               r.campusId == getUserCampusId() &&
               d.campusId == getUserCampusId() &&
               r.get('registrationStatus', null) != 'migration_locked' &&
               hasValidStoredChronology(r) &&
               (
                 (r.status == 'published' && d.status == 'published' && isValidPathwayA(eId, d, r, affected)) ||
                 (r.status == 'published' && d.status == 'cancelled' && isValidPathwayB(eId, d, r, affected)) ||
                 (r.status == 'cancelled' && d.status == 'published' && isValidPathwayC(d, r, affected))
               );
      }

      allow read: if isAuthenticated() && (
        (!('campusId' in resource.data) || resource.data.campusId == getUserCampusId()) && (
          resource.data.visibility == 'campus_public' ||
          (
            resource.data.visibility == 'community_only' &&
            isCommunityActiveMember(resource.data.communityId)
          )
        )
      );

      allow create: if isAuthenticated() && isValidEventCreate(eventId);

      allow update: if isAuthenticated() && isValidEventUpdate(eventId);

      allow delete: if isAuthenticated() &&
                       resource.data.campusId == getUserCampusId() &&
                       resource.data.get('registrationStatus', null) != 'migration_locked' &&
                       isCommunityAdmin(resource.data.communityId) &&
                       resource.data.status in ['published', 'cancelled'] &&
                       hasValidStoredChronology(resource.data) &&
                       request.time < resource.data.startAt &&
                       !exists(/databases/$(database)/documents/eventCapacities/$(eventId));
    }

    // 10. Event RSVPs collection (Milestone 21, 22 & Milestone 24)
    match /eventRsvps/{rsvpId} {
      function isParentEventReadable(eventId) {
        let eventPath = /databases/$(database)/documents/events/$(eventId);
        let eventDoc = exists(eventPath) ? get(eventPath) : null;
        return eventDoc != null &&
               eventDoc.data.campusId == getUserCampusId() &&
               (
                 eventDoc.data.visibility == 'campus_public' ||
                 (eventDoc.data.visibility == 'community_only' && isCommunityActiveMember(eventDoc.data.communityId))
               );
      }

      function isValidRsvpCreate(rId) {
        let d = request.resource.data;
        let eventPath = /databases/$(database)/documents/events/$(d.eventId);
        let capPath = /databases/$(database)/documents/eventCapacities/$(d.eventId);
        let eventDoc = exists(eventPath) ? get(eventPath) : null;
        let isCapped = eventDoc != null && ('capacity' in eventDoc.data) && eventDoc.data.capacity != null;
        let capDoc = (isCapped && exists(capPath)) ? get(capPath) : null;
        let capAfter = (isCapped && existsAfter(capPath)) ? getAfter(capPath) : null;

        let isCommunityMember =
          eventDoc != null && eventDoc.data.visibility == 'community_only' ?
            isCommunityActiveMember(eventDoc.data.communityId) :
            true;

        let isRsvpBaseValid =
          d.keys().hasOnly(['id', 'eventId', 'campusId', 'userId', 'createdAt']) &&
          d.keys().hasAll(['id', 'eventId', 'campusId', 'userId', 'createdAt']) &&
          d.id == rId &&
          d.id is string &&
          d.eventId is string &&
          d.campusId is string &&
          d.userId is string &&
          d.createdAt is timestamp &&
          d.userId == request.auth.uid &&
          d.id == d.eventId + '_' + d.userId &&
          getUserCampusId() != null &&
          d.campusId == getUserCampusId() &&
          d.createdAt == request.time &&
          eventDoc != null &&
          eventDoc.data.campusId == d.campusId &&
          eventDoc.data.status == 'published' &&
          request.time < eventDoc.data.startAt &&
          eventDoc.data.get('registrationStatus', null) != 'migration_locked' &&
          (eventDoc.data.visibility == 'campus_public' || (eventDoc.data.visibility == 'community_only' && isCommunityMember));

        let isDirectAdmission =
          isCapped && capDoc != null && capAfter != null &&
          capDoc.data.confirmedCount + capDoc.data.offeredCount < eventDoc.data.capacity &&
          capAfter.data.confirmedCount == capDoc.data.confirmedCount + 1 &&
          capAfter.data.offeredCount == capDoc.data.offeredCount &&
          capAfter.data.waitlistCount == capDoc.data.waitlistCount &&
          capAfter.data.headSequence == capDoc.data.headSequence &&
          capAfter.data.nextSequence == capDoc.data.nextSequence;

        let isUncappedCreate = !isCapped && !exists(capPath) && !existsAfter(capPath);

        return isRsvpBaseValid && (isUncappedCreate || isDirectAdmission);
      }

      function isValidRsvpDelete(rId) {
        let r = resource.data;
        let eventPath = /databases/$(database)/documents/events/$(r.eventId);
        let capPath = /databases/$(database)/documents/eventCapacities/$(r.eventId);
        let eventDoc = exists(eventPath) ? get(eventPath) : null;
        let isCapped = eventDoc != null && ('capacity' in eventDoc.data) && eventDoc.data.capacity != null;
        let capDoc = (isCapped && exists(capPath)) ? get(capPath) : null;
        let capAfter = (isCapped && existsAfter(capPath)) ? getAfter(capPath) : null;

        let isUncappedDelete =
          !isCapped && !exists(capPath);

        let isCappedZeroWaitlistDelete =
          isCapped && capDoc != null && capAfter != null &&
          request.time < eventDoc.data.startAt &&
          capDoc.data.waitlistCount == 0 &&
          capAfter.data.waitlistCount == 0 &&
          capAfter.data.confirmedCount == capDoc.data.confirmedCount - 1 &&
          capAfter.data.confirmedCount >= 0 &&
          capAfter.data.offeredCount == capDoc.data.offeredCount &&
          capAfter.data.headSequence == capDoc.data.headSequence &&
          capAfter.data.nextSequence == capDoc.data.nextSequence;

        return r.id == rId &&
               r.userId == request.auth.uid &&
               (eventDoc == null || eventDoc.data.get('registrationStatus', null) != 'migration_locked') &&
               (isUncappedDelete || isCappedZeroWaitlistDelete);
      }

      allow get: if isAuthenticated() && (
        (resource == null && rsvpId.matches('^.+_' + request.auth.uid + '$')) ||
        (resource != null && resource.data.campusId == getUserCampusId() && (
          resource.data.userId == request.auth.uid ||
          isParentEventReadable(resource.data.eventId)
        ))
      );

      allow list: if isAuthenticated() && resource.data.campusId == getUserCampusId() && (
        resource.data.userId == request.auth.uid ||
        isParentEventReadable(resource.data.eventId)
      );

      allow create: if isAuthenticated() && isValidRsvpCreate(rsvpId);
      allow update: if false;
      allow delete: if isAuthenticated() && isValidRsvpDelete(rsvpId);
    }

    // 12. Event Capacity Coordinators collection (Milestone 24)
    match /eventCapacities/{eventId} {
      function isValidCoordinatorCreate(eId) {
        let d = request.resource.data;
        let eventPath = /databases/$(database)/documents/events/$(eId);
        let capPath = /databases/$(database)/documents/eventCapacities/$(eId);
        let eventDoc = existsAfter(eventPath) ? getAfter(eventPath) : null;

        return !exists(eventPath) && existsAfter(eventPath) &&
               !exists(capPath) &&
               d.keys().hasOnly([
                 'id', 'eventId', 'campusId', 'confirmedCount', 'offeredCount',
                 'waitlistCount', 'headSequence', 'nextSequence', 'createdAt', 'updatedAt'
               ]) &&
               d.keys().hasAll([
                 'id', 'eventId', 'campusId', 'confirmedCount', 'offeredCount',
                 'waitlistCount', 'headSequence', 'nextSequence', 'createdAt', 'updatedAt'
               ]) &&
               d.id == eId &&
               d.eventId == eId &&
               d.campusId == getUserCampusId() &&
               d.confirmedCount == 0 &&
               d.offeredCount == 0 &&
               d.waitlistCount == 0 &&
               d.headSequence == 1 &&
               d.nextSequence == 1 &&
               d.createdAt == request.time &&
               d.updatedAt == request.time &&
               eventDoc != null &&
               eventDoc.data.campusId == getUserCampusId() &&
               eventDoc.data.createdBy == request.auth.uid &&
               eventDoc.data.communityId != null &&
               isCommunityModeratorOrAdmin(eventDoc.data.communityId);
      }

      function isCoordinatorDirectAdmission(eId, d, r, affected, eventDoc) {
        let rsvpPath = /databases/$(database)/documents/eventRsvps/$(eId + '_' + request.auth.uid);
        return affected.hasOnly(['confirmedCount', 'updatedAt']) &&
               eventDoc.data.status == 'published' &&
               request.time < eventDoc.data.startAt &&
               r.confirmedCount + r.offeredCount < eventDoc.data.capacity &&
               r.waitlistCount == 0 &&
               d.confirmedCount == r.confirmedCount + 1 &&
               d.offeredCount == r.offeredCount &&
               d.waitlistCount == 0 &&
               d.headSequence == r.headSequence &&
               d.nextSequence == r.nextSequence &&
               !exists(rsvpPath) && existsAfter(rsvpPath);
      }

      function isCoordinatorWaitlistJoin(eId, d, r, affected, eventDoc) {
        let memberPath = /databases/$(database)/documents/eventWaitlistMembers/$(eId + '_' + request.auth.uid);
        let slotPath = /databases/$(database)/documents/eventWaitlistSlots/$(eId + '_' + string(r.nextSequence));
        let rsvpPath = /databases/$(database)/documents/eventRsvps/$(eId + '_' + request.auth.uid);
        let memAfter = existsAfter(memberPath) ? getAfter(memberPath) : null;
        let slotAfter = existsAfter(slotPath) ? getAfter(slotPath) : null;

        return eventDoc.data.status == 'published' &&
               request.time < eventDoc.data.startAt &&
               (r.confirmedCount + r.offeredCount >= eventDoc.data.capacity || r.waitlistCount > 0) &&
               d.waitlistCount == r.waitlistCount + 1 &&
               d.nextSequence == r.nextSequence + 1 &&
               d.confirmedCount == r.confirmedCount &&
               d.offeredCount == r.offeredCount &&
               d.headSequence == r.headSequence &&
               !exists(memberPath) && memAfter != null &&
               memAfter.data.sequenceNumber == r.nextSequence &&
               memAfter.data.status == 'waiting' &&
               !exists(slotPath) && slotAfter != null &&
               slotAfter.data.userId == request.auth.uid &&
               slotAfter.data.sequenceNumber == r.nextSequence &&
               slotAfter.data.status == 'waiting' &&
               !exists(rsvpPath) && !existsAfter(rsvpPath);
      }

      function isCoordinatorWithdrawal(eId, d, r, affected, eventDoc) {
        let rsvpPath = /databases/$(database)/documents/eventRsvps/$(eId + '_' + request.auth.uid);

        return affected.hasOnly(['confirmedCount', 'updatedAt']) &&
               eventDoc.data.status == 'published' &&
               request.time < eventDoc.data.startAt &&
               exists(rsvpPath) && !existsAfter(rsvpPath) &&
               r.waitlistCount == 0 &&
               d.waitlistCount == 0 &&
               d.confirmedCount == r.confirmedCount - 1 &&
               d.confirmedCount >= 0 &&
               d.offeredCount == r.offeredCount &&
               d.headSequence == r.headSequence &&
               d.nextSequence == r.nextSequence;
      }

      function isCoordinatorNonHeadWaitingWithdrawal(eId, d, r, affected, eventDoc) {
        let memberPath = /databases/$(database)/documents/eventWaitlistMembers/$(eId + '_' + request.auth.uid);
        let memberDoc = exists(memberPath) ? get(memberPath) : null;
        let slotPath = memberDoc != null ?
          /databases/$(database)/documents/eventWaitlistSlots/$(eId + '_' + string(memberDoc.data.sequenceNumber)) : null;
        let slotAfter = slotPath != null && existsAfter(slotPath) ? getAfter(slotPath) : null;

        return eventDoc.data.status == 'published' &&
               request.time < eventDoc.data.startAt &&
               memberDoc != null &&
               memberDoc.data.sequenceNumber > r.headSequence &&
               memberDoc.data.status == 'waiting' &&
               d.waitlistCount == r.waitlistCount - 1 &&
               d.waitlistCount >= 0 &&
               d.confirmedCount == r.confirmedCount &&
               d.offeredCount == r.offeredCount &&
               d.headSequence == r.headSequence &&
               d.nextSequence == r.nextSequence &&
               exists(memberPath) && !existsAfter(memberPath) &&
               slotPath != null && exists(slotPath) &&
               slotAfter != null &&
               slotAfter.data.status == 'withdrawn' &&
               slotAfter.data.resolvedAt == request.time;
      }

      function isValidCoordinatorUpdate(eId) {
        let d = request.resource.data;
        let r = resource.data;
        let diff = d.diff(r);
        let affected = diff.affectedKeys();
        let eventPath = /databases/$(database)/documents/events/$(eId);
        let eventDoc = exists(eventPath) ? get(eventPath) : null;

        return eventDoc != null &&
               r.campusId == getUserCampusId() &&
               d.campusId == getUserCampusId() &&
               d.id == r.id &&
               d.eventId == r.eventId &&
               d.createdAt == r.createdAt &&
               d.updatedAt == request.time &&
               eventDoc.data.campusId == getUserCampusId() &&
               eventDoc.data.get('registrationStatus', null) != 'migration_locked' &&
               (
                 (affected.hasOnly(['waitlistCount', 'updatedAt']) &&
                  isCoordinatorNonHeadWaitingWithdrawal(eId, d, r, affected, eventDoc)) ||
                 (affected.hasOnly(['confirmedCount', 'updatedAt']) &&
                  (isCoordinatorDirectAdmission(eId, d, r, affected, eventDoc) ||
                   isCoordinatorWithdrawal(eId, d, r, affected, eventDoc))) ||
                 (affected.hasOnly(['waitlistCount', 'nextSequence', 'updatedAt']) &&
                  isCoordinatorWaitlistJoin(eId, d, r, affected, eventDoc))
               );
      }

      allow read: if isAuthenticated() && resource.data.campusId == getUserCampusId();
      allow create: if isAuthenticated() && isValidCoordinatorCreate(eventId);
      allow update: if isAuthenticated() && isValidCoordinatorUpdate(eventId);
      allow delete: if false;
    }

    // 13. Event Waitlist Slots collection (Milestone 24)
    match /eventWaitlistSlots/{slotId} {
      function isValidSlotCreate(sId) {
        let d = request.resource.data;
        let capPath = /databases/$(database)/documents/eventCapacities/$(d.eventId);
        let memberPath = /databases/$(database)/documents/eventWaitlistMembers/$(d.eventId + '_' + d.userId);
        let rsvpPath = /databases/$(database)/documents/eventRsvps/$(d.eventId + '_' + d.userId);
        let eventDoc = exists(/databases/$(database)/documents/events/$(d.eventId)) ?
          get(/databases/$(database)/documents/events/$(d.eventId)) : null;
        let capDoc = exists(capPath) ? get(capPath) : null;
        let capAfter = existsAfter(capPath) ? getAfter(capPath) : null;
        let memAfter = existsAfter(memberPath) ? getAfter(memberPath) : null;

        return d.keys().hasOnly([
                 'id', 'eventId', 'campusId', 'userId', 'sequenceNumber',
                 'status', 'joinedAt', 'offeredAt', 'offerExpiresAt', 'resolvedAt'
               ]) &&
               d.keys().hasAll([
                 'id', 'eventId', 'campusId', 'userId', 'sequenceNumber',
                 'status', 'joinedAt'
               ]) &&
               d.id == sId &&
               d.userId == request.auth.uid &&
               d.campusId == getUserCampusId() &&
               d.status == 'waiting' &&
               d.joinedAt == request.time &&
               !('offeredAt' in d) &&
               !('offerExpiresAt' in d) &&
               !('resolvedAt' in d) &&
               eventDoc != null &&
               eventDoc.data.status == 'published' &&
               eventDoc.data.campusId == getUserCampusId() &&
               eventDoc.data.get('registrationStatus', null) != 'migration_locked' &&
               request.time < eventDoc.data.startAt &&
               capDoc != null &&
               d.sequenceNumber == capDoc.data.nextSequence &&
               sId == d.eventId + '_' + string(d.sequenceNumber) &&
               capAfter != null &&
               capAfter.data.waitlistCount == capDoc.data.waitlistCount + 1 &&
               capAfter.data.nextSequence == capDoc.data.nextSequence + 1 &&
               capAfter.data.headSequence == capDoc.data.headSequence &&
               !exists(memberPath) && memAfter != null &&
               memAfter.data.sequenceNumber == d.sequenceNumber &&
               memAfter.data.status == 'waiting' &&
               !exists(rsvpPath) && !existsAfter(rsvpPath);
      }

      function isSlotWithdrawUpdate(sId, d, r, affected, eventDoc) {
        let capPath = /databases/$(database)/documents/eventCapacities/$(r.eventId);
        let capDoc = exists(capPath) ? get(capPath) : null;
        let capAfter = existsAfter(capPath) ? getAfter(capPath) : null;
        let memberPath = /databases/$(database)/documents/eventWaitlistMembers/$(r.eventId + '_' + r.userId);

        return r.status == 'waiting' &&
               d.status == 'withdrawn' &&
               affected.hasOnly(['status', 'resolvedAt']) &&
               r.userId == request.auth.uid &&
               request.time < eventDoc.data.startAt &&
               d.resolvedAt == request.time &&
               capDoc != null &&
               r.sequenceNumber > capDoc.data.headSequence &&
               capAfter != null &&
               capAfter.data.waitlistCount == capDoc.data.waitlistCount - 1 &&
               capAfter.data.headSequence == capDoc.data.headSequence &&
               !existsAfter(memberPath);
      }

      function isValidSlotUpdate(sId) {
        let d = request.resource.data;
        let r = resource.data;
        let diff = d.diff(r);
        let affected = diff.affectedKeys();
        let eventPath = /databases/$(database)/documents/events/$(r.eventId);
        let eventDoc = exists(eventPath) ? get(eventPath) : null;

        return eventDoc != null &&
               r.campusId == getUserCampusId() &&
               d.campusId == getUserCampusId() &&
               d.id == r.id &&
               d.eventId == r.eventId &&
               d.userId == r.userId &&
               d.sequenceNumber == r.sequenceNumber &&
               d.joinedAt == r.joinedAt &&
               eventDoc.data.campusId == getUserCampusId() &&
               eventDoc.data.get('registrationStatus', null) != 'migration_locked' &&
               isSlotWithdrawUpdate(sId, d, r, affected, eventDoc);
      }

      function isSlotParentEventLeader(eventId) {
        let eventPath = /databases/$(database)/documents/events/$(eventId);
        let eventDoc = exists(eventPath) ? get(eventPath) : null;
        return eventDoc != null &&
               eventDoc.data.campusId == getUserCampusId() &&
               eventDoc.data.communityId != null &&
               isCommunityModeratorOrAdmin(eventDoc.data.communityId);
      }

      allow get: if isAuthenticated() && resource.data.campusId == getUserCampusId() && (
        resource.data.userId == request.auth.uid ||
        isSlotParentEventLeader(resource.data.eventId)
      );

      allow list: if isAuthenticated() && resource.data.campusId == getUserCampusId() && (
        resource.data.userId == request.auth.uid ||
        isSlotParentEventLeader(resource.data.eventId)
      );

      allow create: if isAuthenticated() && isValidSlotCreate(slotId);
      allow update: if isAuthenticated() && isValidSlotUpdate(slotId);
      allow delete: if false;
    }

    // 14. Event Waitlist Members collection (Milestone 24)
    match /eventWaitlistMembers/{memberId} {
      function isValidMemberCreate(mId) {
        let d = request.resource.data;
        let capPath = /databases/$(database)/documents/eventCapacities/$(d.eventId);
        let slotPath = /databases/$(database)/documents/eventWaitlistSlots/$(d.eventId + '_' + string(d.sequenceNumber));
        let rsvpPath = /databases/$(database)/documents/eventRsvps/$(d.eventId + '_' + d.userId);
        let eventDoc = exists(/databases/$(database)/documents/events/$(d.eventId)) ?
          get(/databases/$(database)/documents/events/$(d.eventId)) : null;
        let capDoc = exists(capPath) ? get(capPath) : null;
        let capAfter = existsAfter(capPath) ? getAfter(capPath) : null;
        let slotAfter = existsAfter(slotPath) ? getAfter(slotPath) : null;

        return d.keys().hasOnly([
                 'id', 'eventId', 'campusId', 'userId', 'sequenceNumber',
                 'status', 'joinedAt', 'updatedAt'
               ]) &&
               d.keys().hasAll([
                 'id', 'eventId', 'campusId', 'userId', 'sequenceNumber',
                 'status', 'joinedAt', 'updatedAt'
               ]) &&
               d.id == mId &&
               mId == d.eventId + '_' + d.userId &&
               d.userId == request.auth.uid &&
               d.campusId == getUserCampusId() &&
               d.status == 'waiting' &&
               d.joinedAt == request.time &&
               d.updatedAt == request.time &&
               eventDoc != null &&
               eventDoc.data.campusId == getUserCampusId() &&
               eventDoc.data.status == 'published' &&
               eventDoc.data.get('registrationStatus', null) != 'migration_locked' &&
               request.time < eventDoc.data.startAt &&
               capDoc != null &&
               d.sequenceNumber == capDoc.data.nextSequence &&
               capAfter != null &&
               capAfter.data.waitlistCount == capDoc.data.waitlistCount + 1 &&
               capAfter.data.nextSequence == capDoc.data.nextSequence + 1 &&
               capAfter.data.headSequence == capDoc.data.headSequence &&
               !exists(slotPath) && slotAfter != null &&
               slotAfter.data.userId == d.userId &&
               slotAfter.data.sequenceNumber == d.sequenceNumber &&
               slotAfter.data.status == 'waiting' &&
               !exists(rsvpPath) && !existsAfter(rsvpPath);
      }

      function isValidMemberDelete(mId) {
        let r = resource.data;
        let slotPath = /databases/$(database)/documents/eventWaitlistSlots/$(r.eventId + '_' + string(r.sequenceNumber));
        let eventPath = /databases/$(database)/documents/events/$(r.eventId);
        let eventDoc = exists(eventPath) ? get(eventPath) : null;
        let capPath = /databases/$(database)/documents/eventCapacities/$(r.eventId);
        let capDoc = exists(capPath) ? get(capPath) : null;
        let capAfter = existsAfter(capPath) ? getAfter(capPath) : null;
        let slotAfter = existsAfter(slotPath) ? getAfter(slotPath) : null;

        let isNonHeadWithdrawal =
          r.status == 'waiting' &&
          r.userId == request.auth.uid &&
          capDoc != null &&
          r.sequenceNumber > capDoc.data.headSequence &&
          slotAfter != null &&
          slotAfter.data.status == 'withdrawn' &&
          capAfter != null &&
          capAfter.data.waitlistCount == capDoc.data.waitlistCount - 1 &&
          capAfter.data.headSequence == capDoc.data.headSequence;

        return eventDoc != null &&
               r.campusId == getUserCampusId() &&
               eventDoc.data.campusId == getUserCampusId() &&
               eventDoc.data.get('registrationStatus', null) != 'migration_locked' &&
               request.time < eventDoc.data.startAt &&
               isNonHeadWithdrawal;
      }

      function isMemberParentEventLeader(eventId) {
        let eventPath = /databases/$(database)/documents/events/$(eventId);
        let eventDoc = exists(eventPath) ? get(eventPath) : null;
        return eventDoc != null &&
               eventDoc.data.campusId == getUserCampusId() &&
               eventDoc.data.communityId != null &&
               isCommunityModeratorOrAdmin(eventDoc.data.communityId);
      }

      allow get: if isAuthenticated() && (
        (resource == null && memberId.matches('^.+_' + request.auth.uid + '$')) ||
        (resource != null && resource.data.campusId == getUserCampusId() && (
          resource.data.userId == request.auth.uid ||
          isMemberParentEventLeader(resource.data.eventId)
        ))
      );

      allow list: if false;
      allow create: if isAuthenticated() && isValidMemberCreate(memberId);
      allow update: if false;
      allow delete: if isAuthenticated() && isValidMemberDelete(memberId);
    }

    // 15. Event Waitlist Continuations collection (Milestone 24)
    match /eventWaitlistContinuations/{continuationId} {
      allow read, write: if false;
    }

    // 16. Event Waitlist Outbox collection (Milestone 24)
    match /eventWaitlistOutbox/{outboxId} {
      allow read, write: if false;
    }

    // 17. System Waitlist Jobs collection (Milestone 24)
    match /systemWaitlistJobs/{jobId} {
      allow read, write: if false;
    }

    // 11. Event Notification Deliveries collection (Milestone 23.2: Delivery Ledger Security Authority)
    match /eventNotificationDeliveries/{eventId} {
      function isValidLedgerActorProfile() {
        let pubPath = /databases/$(database)/documents/publicProfiles/$(request.auth.uid);
        let pubDoc = exists(pubPath) ? get(pubPath) : null;
        return pubDoc != null &&
               request.resource.data.actorName == pubDoc.data.get('displayName', 'CampusConnect Student') &&
               request.resource.data.actorAvatar == pubDoc.data.get('photoURL', null);
      }

      function isValidLedgerCreate(eId) {
        let d = request.resource.data;
        let eventPath = /databases/$(database)/documents/events/$(eId);

        return d.keys().hasAll([
                 'id', 'eventId', 'cycleId', 'campusId', 'communityId',
                 'actorId', 'actorName', 'actorAvatar', 'status',
                 'checkpointVersion', 'processedCount', 'createdAt', 'updatedAt'
               ]) &&
               d.keys().hasOnly([
                 'id', 'eventId', 'cycleId', 'campusId', 'communityId',
                 'actorId', 'actorName', 'actorAvatar', 'status',
                 'checkpointVersion', 'lastProcessedRsvpId', 'processedCount',
                 'createdAt', 'updatedAt'
               ]) &&
               d.id == eId &&
               d.eventId == eId &&
               d.cycleId is string &&
               d.cycleId.size() >= 10 &&
               d.cycleId.size() <= 64 &&
               d.campusId is string &&
               getUserCampusId() != null &&
               d.campusId == getUserCampusId() &&
               d.communityId is string &&
               isCommunityModeratorOrAdmin(d.communityId) &&
               existsAfter(eventPath) &&
               getAfter(eventPath).data.status == 'cancelled' &&
               getAfter(eventPath).data.campusId == d.campusId &&
               getAfter(eventPath).data.communityId == d.communityId &&
               d.actorId == request.auth.uid &&
               isValidLedgerActorProfile() &&
               d.status == 'pending' &&
               d.checkpointVersion == 0 &&
               d.processedCount == 0 &&
               (!('lastProcessedRsvpId' in d) || d.lastProcessedRsvpId == null) &&
               d.createdAt == request.time &&
               d.updatedAt == request.time;
      }

      function isValidLedgerRepeatCancellationUpdate(eId) {
        let d = request.resource.data;
        let r = resource.data;
        let eventPath = /databases/$(database)/documents/events/$(eId);

        return isCommunityModeratorOrAdmin(r.communityId) &&
               r.campusId == getUserCampusId() &&
               exists(eventPath) &&
               get(eventPath).data.status == 'published' &&
               existsAfter(eventPath) &&
               getAfter(eventPath).data.status == 'cancelled' &&
               getAfter(eventPath).data.campusId == r.campusId &&
               getAfter(eventPath).data.communityId == r.communityId &&
               r.status in ['completed', 'superseded'] &&
               d.diff(r).affectedKeys().hasOnly([
                 'cycleId', 'actorId', 'actorName', 'actorAvatar',
                 'status', 'checkpointVersion', 'lastProcessedRsvpId',
                 'processedCount', 'updatedAt'
               ]) &&
               d.id == r.id &&
               d.eventId == r.eventId &&
               d.campusId == r.campusId &&
               d.communityId == r.communityId &&
               d.cycleId is string &&
               d.cycleId.size() >= 10 &&
               d.cycleId.size() <= 64 &&
               d.cycleId != r.cycleId &&
               d.actorId == request.auth.uid &&
               isValidLedgerActorProfile() &&
               d.status == 'pending' &&
               d.checkpointVersion == 0 &&
               d.processedCount == 0 &&
               (!('lastProcessedRsvpId' in d) || d.lastProcessedRsvpId == null) &&
               d.updatedAt == request.time;
      }

      function isValidLedgerCheckpointUpdate(eId) {
        let d = request.resource.data;
        let r = resource.data;
        let eventPath = /databases/$(database)/documents/events/$(eId);

        return exists(eventPath) &&
               get(eventPath).data.status == 'cancelled' &&
               (isCommunityModeratorOrAdmin(r.communityId) || request.auth.uid == get(eventPath).data.createdBy) &&
               r.campusId == getUserCampusId() &&
               r.status in ['pending', 'in_progress'] &&
               d.status in ['in_progress', 'completed'] &&
               d.diff(r).affectedKeys().hasOnly([
                 'status', 'checkpointVersion', 'lastProcessedRsvpId',
                 'processedCount', 'updatedAt'
               ]) &&
               d.id == r.id &&
               d.eventId == r.eventId &&
               d.cycleId == r.cycleId &&
               d.campusId == r.campusId &&
               d.communityId == r.communityId &&
               d.actorId == r.actorId &&
               d.actorName == r.actorName &&
               d.actorAvatar == r.actorAvatar &&
               d.createdAt == r.createdAt &&
               d.checkpointVersion == r.checkpointVersion + 1 &&
               d.processedCount is int &&
               d.processedCount >= r.processedCount &&
               (!('lastProcessedRsvpId' in d) || d.lastProcessedRsvpId == null || d.lastProcessedRsvpId is string) &&
               d.updatedAt == request.time;
      }

      function isValidLedgerSupersededUpdate(eId) {
        let d = request.resource.data;
        let r = resource.data;
        let eventPath = /databases/$(database)/documents/events/$(eId);

        return isCommunityModeratorOrAdmin(r.communityId) &&
               r.campusId == getUserCampusId() &&
               r.status in ['pending', 'in_progress'] &&
               d.status == 'superseded' &&
               (
                 (existsAfter(eventPath) && getAfter(eventPath).data.status == 'published') ||
                 !existsAfter(eventPath)
               ) &&
               d.diff(r).affectedKeys().hasOnly(['status', 'updatedAt']) &&
               d.id == r.id &&
               d.eventId == r.eventId &&
               d.cycleId == r.cycleId &&
               d.campusId == r.campusId &&
               d.communityId == r.communityId &&
               d.actorId == r.actorId &&
               d.actorName == r.actorName &&
               d.actorAvatar == r.actorAvatar &&
               d.checkpointVersion == r.checkpointVersion &&
               d.processedCount == r.processedCount &&
               d.createdAt == r.createdAt &&
               d.updatedAt == request.time;
      }

      function isAuthorizedToReadLedger(eId) {
        let eventPath = /databases/$(database)/documents/events/$(eId);
        return resource != null ? (
          resource.data.campusId == getUserCampusId() && (
            request.auth.uid == resource.data.actorId ||
            isCommunityModeratorOrAdmin(resource.data.get('communityId', null))
          )
        ) : (
          exists(eventPath) &&
          get(eventPath).data.campusId == getUserCampusId() &&
          isCommunityModeratorOrAdmin(get(eventPath).data.get('communityId', null))
        );
      }

      allow get: if isAuthenticated() && isAuthorizedToReadLedger(eventId);
      allow list: if false;

      allow create: if isAuthenticated() && isValidLedgerCreate(eventId);

      allow update: if isAuthenticated() && (
        (request.resource.data.status in ['in_progress', 'completed'] && isValidLedgerCheckpointUpdate(eventId)) ||
        (request.resource.data.status == 'pending' && isValidLedgerRepeatCancellationUpdate(eventId)) ||
        (request.resource.data.status == 'superseded' && isValidLedgerSupersededUpdate(eventId))
      );

      allow delete: if false;
    }
  }
}
