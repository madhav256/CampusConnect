rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidSocialLinks(socialLinks) {
      return socialLinks is map &&
             socialLinks.keys().hasOnly(['github', 'linkedin', 'portfolio', 'website']) &&
             socialLinks.keys().hasAll(['github', 'linkedin', 'portfolio', 'website']) &&
             socialLinks.github is string &&
             socialLinks.linkedin is string &&
             socialLinks.portfolio is string &&
             socialLinks.website is string;
    }

    function isValidNotificationPreferencesForCreate(preferences) {
      return preferences is map &&
             preferences.keys().hasOnly(['connectionRequests', 'connectionAccepted']) &&
             preferences.keys().hasAll(['connectionRequests', 'connectionAccepted']) &&
             preferences.connectionRequests is bool &&
             preferences.connectionAccepted is bool;
    }

    function isValidNotificationPreferencesForUpdate(preferences) {
      return preferences is map &&
             preferences.keys().hasOnly(['connectionRequests', 'connectionAccepted']) &&
             (!('connectionRequests' in preferences) || preferences.connectionRequests is bool) &&
             (!('connectionAccepted' in preferences) || preferences.connectionAccepted is bool);
    }

    function isValidUserCreate(userId) {
      let d = request.resource.data;
      let pubPath = /databases/$(database)/documents/publicProfiles/$(userId);
      let dirPath = /databases/$(database)/documents/directoryIndex/$(userId);
      return d.keys().hasOnly([
               'uid', 'displayName', 'email', 'photoURL', 'bio',
               'department', 'year', 'skills', 'socialLinks',
               'isDiscoverable', 'notificationPreferences',
               'createdAt', 'updatedAt'
             ]) &&
             d.keys().hasAll([
               'uid', 'displayName', 'email', 'photoURL', 'bio',
               'department', 'year', 'skills', 'socialLinks',
               'isDiscoverable', 'notificationPreferences',
               'createdAt', 'updatedAt'
             ]) &&
             d.uid == userId &&
             d.uid == request.auth.uid &&
             d.email == request.auth.token.email &&
             d.displayName is string &&
             d.email is string &&
             (d.photoURL == null || d.photoURL is string) &&
             d.bio is string &&
             d.department is string &&
             d.year is string &&
             d.skills is list &&
             isValidSocialLinks(d.socialLinks) &&
             d.isDiscoverable is bool &&
             isValidNotificationPreferencesForCreate(d.notificationPreferences) &&
             d.createdAt == request.time &&
             d.updatedAt == request.time &&
             existsAfter(pubPath) &&
             (d.isDiscoverable == true ? existsAfter(dirPath) : !existsAfter(dirPath));
    }

    function isValidPublicProfileSchema(userId) {
      let d = request.resource.data;
      return d.keys().hasOnly([
               'uid', 'displayName', 'photoURL', 'bio',
               'department', 'year', 'skills', 'socialLinks'
             ]) &&
             d.keys().hasAll([
               'uid', 'displayName', 'photoURL', 'bio',
               'department', 'year', 'skills', 'socialLinks'
             ]) &&
             d.uid == userId &&
             d.uid == request.auth.uid &&
             d.displayName is string &&
             (d.photoURL == null || d.photoURL is string) &&
             d.bio is string &&
             d.department is string &&
             d.year is string &&
             d.skills is list &&
             isValidSocialLinks(d.socialLinks);
    }

    function isMatchingDirectoryProjection(dirPath, data) {
      let dirDoc = getAfter(dirPath);
      return dirDoc != null &&
             dirDoc.data.uid == data.uid &&
             dirDoc.data.displayName == data.displayName &&
             dirDoc.data.photoURL == data.photoURL &&
             dirDoc.data.department == data.department &&
             dirDoc.data.year == data.year &&
             dirDoc.data.skills == data.skills;
    }

    function isValidPublicProfileProjection(userId) {
      let userPath = /databases/$(database)/documents/users/$(userId);
      let dirPath = /databases/$(database)/documents/directoryIndex/$(userId);
      let userDoc = getAfter(userPath);
      return userDoc != null && (
        userDoc.data.isDiscoverable == true ? (
          existsAfter(dirPath) &&
          isMatchingDirectoryProjection(dirPath, request.resource.data)
        ) : (
          !existsAfter(dirPath)
        )
      );
    }

    function isValidDirectoryIndexSchema(userId) {
      let d = request.resource.data;
      return d.keys().hasOnly([
               'uid', 'displayName', 'photoURL', 'department',
               'year', 'skills', 'updatedAt'
             ]) &&
             d.keys().hasAll([
               'uid', 'displayName', 'photoURL', 'department',
               'year', 'skills', 'updatedAt'
             ]) &&
             d.uid == userId &&
             d.uid == request.auth.uid &&
             d.displayName is string &&
             (d.photoURL == null || d.photoURL is string) &&
             d.department is string &&
             d.year is string &&
             d.skills is list &&
             d.updatedAt == request.time;
    }

    function isValidDirectoryIndexSync(userId) {
      let userPath = /databases/$(database)/documents/users/$(userId);
      let pubPath = /databases/$(database)/documents/publicProfiles/$(userId);
      let userDoc = getAfter(userPath);
      let pubDoc = getAfter(pubPath);
      return userDoc != null &&
             userDoc.data.isDiscoverable == true &&
             pubDoc != null &&
             request.resource.data.uid == pubDoc.data.uid &&
             request.resource.data.displayName == pubDoc.data.displayName &&
             request.resource.data.photoURL == pubDoc.data.photoURL &&
             request.resource.data.department == pubDoc.data.department &&
             request.resource.data.year == pubDoc.data.year &&
             request.resource.data.skills == pubDoc.data.skills;
    }

    // Validates atomic like/unlike transactions on posts.
    function isValidPostLikeUpdate(postId) {
      let likePath = /databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid);

      let isLike = existsAfter(likePath) &&
                   getAfter(likePath).data.userId == request.auth.uid &&
                   request.resource.data.likesCount == resource.data.likesCount + 1;

      let isUnlike = exists(likePath) &&
                     !existsAfter(likePath) &&
                     request.resource.data.likesCount == resource.data.likesCount - 1 &&
                     request.resource.data.likesCount >= 0;

      let postFieldsProtected =
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'updatedAt']) &&
        request.resource.data.authorId == resource.data.authorId &&
        request.resource.data.authorName == resource.data.authorName &&
        request.resource.data.authorAvatar == resource.data.authorAvatar &&
        request.resource.data.content == resource.data.content &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.commentsCount == resource.data.commentsCount &&
        request.resource.data.updatedAt == request.time;

      return (isLike || isUnlike) && postFieldsProtected;
    }

    // Validates the exact parent mutation used by comment create/delete batches.
    // A parent-only exact +/-1 write remains a documented limitation because this
    // match does not know which arbitrary comment path changed in the same batch.
    function isValidPostCommentCountUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentsCount', 'updatedAt']) &&
             request.resource.data.authorId == resource.data.authorId &&
             request.resource.data.authorName == resource.data.authorName &&
             request.resource.data.authorAvatar == resource.data.authorAvatar &&
             request.resource.data.content == resource.data.content &&
             request.resource.data.createdAt == resource.data.createdAt &&
             request.resource.data.likesCount == resource.data.likesCount &&
             request.resource.data.updatedAt == request.time &&
             request.resource.data.commentsCount >= 0 &&
             (
               request.resource.data.commentsCount == resource.data.commentsCount + 1 ||
               request.resource.data.commentsCount == resource.data.commentsCount - 1
             );
    }

    function isValidCommentSchema() {
      let d = request.resource.data;
      let pubPath = /databases/$(database)/documents/publicProfiles/$(request.auth.uid);
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      let hasPub = exists(pubPath);
      let actorDoc = hasPub ? get(pubPath) : get(userPath);
      return (hasPub || exists(userPath)) &&
             d.keys().hasOnly(['authorId', 'authorName', 'authorAvatar', 'content', 'createdAt', 'updatedAt']) &&
             d.keys().hasAll(['authorId', 'authorName', 'authorAvatar', 'content', 'createdAt', 'updatedAt']) &&
             d.authorId == request.auth.uid &&
             d.authorName == actorDoc.data.get('displayName', 'CampusConnect Student') &&
             d.authorAvatar == actorDoc.data.get('photoURL', null) &&
             d.authorName is string &&
             (d.authorAvatar == null || d.authorAvatar is string) &&
             d.content is string &&
             d.content.size() > 0 &&
             d.createdAt == request.time &&
             d.updatedAt == request.time;
    }

    function isValidCommentCreate(postId) {
      let postPath = /databases/$(database)/documents/posts/$(postId);
      return exists(postPath) &&
             getAfter(postPath).data.commentsCount == get(postPath).data.commentsCount + 1 &&
             getAfter(postPath).data.commentsCount >= 0 &&
             getAfter(postPath).data.updatedAt == request.time;
    }

    function isValidCommentDelete(postId) {
      let postPath = /databases/$(database)/documents/posts/$(postId);
      return resource != null &&
             exists(postPath) &&
             getAfter(postPath).data.commentsCount == get(postPath).data.commentsCount - 1 &&
             getAfter(postPath).data.commentsCount >= 0 &&
             getAfter(postPath).data.updatedAt == request.time;
    }

    function isValidLikeCreate(userId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['userId', 'createdAt']) &&
             d.keys().hasAll(['userId', 'createdAt']) &&
             d.userId == userId &&
             d.userId == request.auth.uid &&
             d.createdAt == request.time;
    }

    // 1. Users collection (Private account / settings - Intermediate Gate)
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserCreate(userId);
      allow update: if isOwner(userId) &&
        resource.data.uid == userId &&
        request.resource.data.uid == userId &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isDiscoverable', 'notificationPreferences', 'updatedAt']) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['notificationPreferences']) ||
         isValidNotificationPreferencesForUpdate(request.resource.data.notificationPreferences)) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isDiscoverable']) ||
         request.resource.data.isDiscoverable is bool) &&
        (request.resource.data.isDiscoverable == true ?
          existsAfter(/databases/$(database)/documents/directoryIndex/$(userId)) :
          !existsAfter(/databases/$(database)/documents/directoryIndex/$(userId)));

      allow delete: if false;

      // 2. User notifications subcollection
      match /notifications/{notificationId} {
        function isValidNotificationSchema(uId) {
          let d = request.resource.data;
          let keys = d.keys();
          return keys.hasOnly(['id', 'recipientId', 'actorId', 'actorName', 'actorAvatar', 'type', 'referenceId', 'isRead', 'createdAt']) &&
                 keys.hasAll(['id', 'recipientId', 'actorId', 'actorName', 'actorAvatar', 'type', 'referenceId', 'isRead', 'createdAt']) &&
                 d.id == notificationId &&
                 d.recipientId == uId &&
                 d.actorId == request.auth.uid &&
                 d.actorId != uId &&
                 d.isRead == false &&
                 d.createdAt == request.time &&
                 d.recipientId is string &&
                 d.actorId is string &&
                 d.actorName is string &&
                 (d.actorAvatar == null || d.actorAvatar is string) &&
                 d.type is string &&
                 d.referenceId is string &&
                 d.isRead is bool &&
                 d.createdAt is timestamp;
        }

        function isValidActorProfile() {
          let pubPath = /databases/$(database)/documents/publicProfiles/$(request.auth.uid);
          let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
          let hasPub = exists(pubPath);
          let actorDoc = hasPub ? get(pubPath) : get(userPath);
          return (hasPub || exists(userPath)) &&
                 request.resource.data.actorName == actorDoc.data.get('displayName', 'CampusConnect Student') &&
                 request.resource.data.actorAvatar == actorDoc.data.get('photoURL', null);
        }

        function isValidConnectionRequestNotification(uId, notifId) {
          let connId = request.resource.data.referenceId;
          let connPath = /databases/$(database)/documents/connections/$(connId);
          return notifId == 'req_' + connId &&
                 request.resource.data.type == 'connection_request' &&
                 existsAfter(connPath) &&
                 getAfter(connPath).data.status == 'pending' &&
                 getAfter(connPath).data.senderId == request.auth.uid &&
                 getAfter(connPath).data.receiverId == uId;
        }

        function isValidConnectionAcceptedNotification(uId, notifId) {
          let connId = request.resource.data.referenceId;
          let connPath = /databases/$(database)/documents/connections/$(connId);
          return notifId == 'acc_' + connId &&
                 request.resource.data.type == 'connection_accepted' &&
                 existsAfter(connPath) &&
                 getAfter(connPath).data.status == 'accepted' &&
                 getAfter(connPath).data.receiverId == request.auth.uid &&
                 getAfter(connPath).data.senderId == uId;
        }

        // Allows an acceptance transaction to refresh an existing deterministic
        // notification without granting the actor general notification updates.
        function isValidConnectionAcceptedNotificationUpdate(uId, notifId) {
          let connId = request.resource.data.referenceId;
          let connPath = /databases/$(database)/documents/connections/$(connId);
          return resource != null &&
                 resource.data.id == notifId &&
                 resource.data.recipientId == uId &&
                 resource.data.actorId == request.auth.uid &&
                 resource.data.type == 'connection_accepted' &&
                 resource.data.referenceId == connId &&
                 existsAfter(connPath) &&
                 getAfter(connPath).data.status == 'accepted' &&
                 getAfter(connPath).data.receiverId == request.auth.uid &&
                 getAfter(connPath).data.senderId == uId;
        }

        function isValidRequestCancellationDelete(uId) {
          return resource != null &&
                 resource.data.id == notificationId &&
                 resource.data.recipientId == uId &&
                 resource.data.actorId == request.auth.uid &&
                 resource.data.type == 'connection_request' &&
                 notificationId == 'req_' + resource.data.referenceId &&
                 exists(/databases/$(database)/documents/connections/$(resource.data.referenceId)) &&
                 get(/databases/$(database)/documents/connections/$(resource.data.referenceId)).data.status == 'pending' &&
                 get(/databases/$(database)/documents/connections/$(resource.data.referenceId)).data.senderId == request.auth.uid &&
                 get(/databases/$(database)/documents/connections/$(resource.data.referenceId)).data.receiverId == uId &&
                 !existsAfter(/databases/$(database)/documents/connections/$(resource.data.referenceId));
        }

        allow list: if isAuthenticated() && request.auth.uid == userId;
        allow get: if isAuthenticated() && request.auth.uid == userId;

        allow create: if isAuthenticated() &&
          isValidNotificationSchema(userId) &&
          isValidActorProfile() &&
          (
            isValidConnectionRequestNotification(userId, notificationId) ||
            isValidConnectionAcceptedNotification(userId, notificationId)
          );

        allow update: if isAuthenticated() && (
          (
            request.auth.uid == userId &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']) &&
            request.resource.data.isRead is bool
          ) ||
          (
            isValidNotificationSchema(userId) &&
            isValidActorProfile() &&
            isValidConnectionAcceptedNotificationUpdate(userId, notificationId)
          )
        );

        allow delete: if isAuthenticated() && (
          request.auth.uid == userId ||
          isValidRequestCancellationDelete(userId) ||
          (resource == null && notificationId.matches('^req_.*'))
        );
      }
    }

    // 1b. Public profiles collection (Sole authority for public profile fields)
    match /publicProfiles/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) &&
        isValidPublicProfileSchema(userId) &&
        isValidPublicProfileProjection(userId);
      allow update: if isOwner(userId) &&
        isValidPublicProfileSchema(userId) &&
        isValidPublicProfileProjection(userId);
      allow delete: if false;
    }

    // 1c. Directory index collection (Projection of publicProfiles)
    match /directoryIndex/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) &&
        isValidDirectoryIndexSchema(userId) &&
        isValidDirectoryIndexSync(userId);
      allow update: if isOwner(userId) &&
        isValidDirectoryIndexSchema(userId) &&
        isValidDirectoryIndexSync(userId);
      allow delete: if isOwner(userId) &&
        getAfter(/databases/$(database)/documents/users/$(userId)).data.isDiscoverable == false;
    }

    // 3. Posts collection
    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.likesCount == 0 &&
        request.resource.data.commentsCount == 0 &&
        request.resource.data.createdAt == request.time;

      // Posts are not editable. Only the validated counter/like paths remain.
      allow update: if isAuthenticated() && (
        isValidPostCommentCountUpdate() ||
        isValidPostLikeUpdate(postId)
      );

      allow delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() &&
          isValidCommentSchema() &&
          isValidCommentCreate(postId);
        allow update: if false;
        allow delete: if isAuthenticated() &&
          resource.data.authorId == request.auth.uid &&
          isValidCommentDelete(postId);
      }

      match /likes/{userId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && isValidLikeCreate(userId);
        allow delete: if isAuthenticated() && request.auth.uid == userId;
        allow update: if false;
      }
    }

    // 4. Connections collection
    match /connections/{connectionId} {
      function isValidConnectionId(connId, sId, rId) {
        return connId == (sId < rId ? sId + '_' + rId : rId + '_' + sId);
      }

      function isValidUsersArray(users, sId, rId) {
        return users.size() == 2 &&
               users.hasAll([sId, rId]) &&
               users[0] == (sId < rId ? sId : rId) &&
               users[1] == (sId < rId ? rId : sId);
      }

      allow get: if isAuthenticated() && (resource == null || request.auth.uid in resource.data.users);
      allow list: if isAuthenticated() && request.auth.uid in resource.data.users;

      allow create: if isAuthenticated() &&
        request.resource.data.senderId == request.auth.uid &&
        request.resource.data.receiverId != request.auth.uid &&
        isValidConnectionId(connectionId, request.resource.data.senderId, request.resource.data.receiverId) &&
        isValidUsersArray(request.resource.data.users, request.resource.data.senderId, request.resource.data.receiverId) &&
        request.resource.data.status == 'pending' &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.keys().hasOnly(['users', 'senderId', 'receiverId', 'status', 'createdAt', 'updatedAt']) &&
        request.resource.data.keys().hasAll(['users', 'senderId', 'receiverId', 'status', 'createdAt', 'updatedAt']);

      allow update: if isAuthenticated() &&
        resource.data.receiverId == request.auth.uid &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'accepted' &&
        request.resource.data.senderId == resource.data.senderId &&
        request.resource.data.receiverId == resource.data.receiverId &&
        request.resource.data.users == resource.data.users &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
        request.resource.data.updatedAt == request.time;

      allow delete: if isAuthenticated() && (
        (resource.data.status == 'pending' && resource.data.senderId == request.auth.uid) ||
        (resource.data.status == 'pending' && resource.data.receiverId == request.auth.uid) ||
        (resource.data.status == 'accepted' && request.auth.uid in resource.data.users)
      );
    }
  }
}
